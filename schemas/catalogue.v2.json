{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tellurian Trains Drawing Catalogue file",
  "description": "A .catalogue.json file, schema version 2. What is drawn in millimetres and degrees; track and platform lengths, centres and distances in metres.",
  "type": "object",
  "properties": {
    "format": {
      "const": "tellurian-drawing"
    },
    "kind": {
      "const": "Catalogue"
    },
    "schemaVersion": {
      "const": 2
    },
    "appVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "$ref": "#/$defs/Catalogue"
    }
  },
  "required": [
    "format",
    "kind",
    "schemaVersion",
    "content"
  ],
  "$defs": {
    "Catalogue": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "scales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SharedScale"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SharedModuleStandard"
          }
        },
        "addOns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StandardAddOn"
          }
        },
        "endProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EndProfile"
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EndProfileCompatibilityOverride"
          }
        },
        "externalReferences": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "CatalogueReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Circle": {
      "type": "object",
      "properties": {
        "center": {
          "$ref": "#/$defs/Point"
        },
        "diameter": {
          "type": "number"
        }
      },
      "required": [
        "center",
        "diameter"
      ]
    },
    "DocumentReference": {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DrawingRevision": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "name",
        "date"
      ]
    },
    "EndProfile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "designation": {
          "type": "string"
        },
        "shortName": {
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "type": "string"
        },
        "standards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogueReference"
          }
        },
        "outline": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathDrawing"
            },
            {
              "type": "null"
            }
          ]
        },
        "plate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlateShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "groundLine": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathDrawing"
            },
            {
              "type": "null"
            }
          ]
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EndProfileTrack"
          }
        },
        "screwHoles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Circle"
          }
        },
        "dowels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Circle"
          }
        },
        "screwHolePattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalReferences": {
          "type": [
            "object",
            "null"
          ]
        },
        "revision": {
          "type": "integer"
        },
        "revisionLog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DrawingRevision"
          }
        }
      },
      "required": [
        "id",
        "designation",
        "scale"
      ]
    },
    "EndProfileCompatibilityOverride": {
      "type": "object",
      "properties": {
        "firstEndProfileId": {
          "type": "string",
          "format": "uuid"
        },
        "secondEndProfileId": {
          "type": "string",
          "format": "uuid"
        },
        "fit": {
          "enum": [
            "Fits",
            "FitsWithMismatch",
            "FitsWithClamps",
            "Incompatible"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "firstEndProfileId",
        "secondEndProfileId",
        "fit"
      ]
    },
    "EndProfileTrack": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "number"
        },
        "gauges": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "railSystem": {
          "enum": [
            "TwoRail",
            "ThreeRail"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "gauges"
      ]
    },
    "PathDrawing": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/Point"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathStep"
          }
        },
        "isClosed": {
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "steps"
      ]
    },
    "PathStep": {
      "type": "object",
      "required": [
        "type"
      ],
      "anyOf": [
        {
          "properties": {
            "type": {
              "const": "line"
            },
            "end": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "end"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "arc"
            },
            "center": {
              "$ref": "#/$defs/Point"
            },
            "sweep": {
              "type": "number"
            }
          },
          "required": [
            "center",
            "sweep"
          ]
        }
      ]
    },
    "PlateSegment": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Line",
            "Arc",
            "Fillet"
          ]
        },
        "end": true,
        "center": true,
        "radius": {
          "type": [
            "number",
            "null"
          ]
        },
        "side": {
          "enum": [
            "Above",
            "Below",
            null
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "PlateShape": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/Point"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlateSegment"
          }
        },
        "bottom": {
          "type": "number"
        }
      },
      "required": [
        "start",
        "segments",
        "bottom"
      ]
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "SharedModuleStandard": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "shortName": {
          "type": "string"
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/SharedScale"
            },
            {
              "type": "null"
            }
          ]
        },
        "trackSystem": {
          "type": [
            "string",
            "null"
          ]
        },
        "railSystem": {
          "enum": [
            "TwoRail",
            "ThreeRail",
            null
          ]
        },
        "gauges": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/TrackGauge"
          }
        },
        "couplings": {
          "type": [
            "string",
            "null"
          ]
        },
        "electricity": {
          "type": [
            "string",
            "null"
          ]
        },
        "wheelset": {
          "type": [
            "string",
            "null"
          ]
        },
        "railTopHeight": {
          "type": [
            "number",
            "null"
          ]
        },
        "minimumClearance": {
          "type": [
            "number",
            "null"
          ]
        },
        "operatorSpaceDepth": {
          "type": [
            "number",
            "null"
          ]
        },
        "trackColor": {
          "type": [
            "string",
            "null"
          ]
        },
        "foulingDistance": {
          "type": [
            "number",
            "null"
          ]
        },
        "minimumReverseCurveRadius": {
          "type": [
            "number",
            "null"
          ]
        },
        "defaultCurveRadius": {
          "type": [
            "number",
            "null"
          ]
        },
        "defaultSingleTrackEndProfileId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "defaultDoubleTrackEndProfileId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalReferences": {
          "type": [
            "object",
            "null"
          ]
        },
        "countries": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "shortName"
      ]
    },
    "SharedScale": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "shortName": {
          "type": "string"
        },
        "denominator": {
          "type": [
            "number",
            "null"
          ]
        },
        "remark": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "shortName"
      ]
    },
    "StandardAddOn": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "shortName": {
          "type": "string"
        },
        "baseStandardId": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "shortName",
        "baseStandardId"
      ]
    },
    "TrackGauge": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "prototypeWidth": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "width"
      ]
    }
  }
}
