<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tellurian.Trains.Drawing.Editing\Tellurian.Trains.Drawing.Editing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample catalogue for tests (TestData/SampleCatalogue.cs): the app has no built-in catalogue. -->
    <Compile Include="..\TestData\SampleCatalogue.cs" Link="TestData\SampleCatalogue.cs" />
    <EmbeddedResource Include="..\TestData\sample.catalogue.json" LogicalName="sample.catalogue.json" />
    <Using Include="Tellurian.Trains.Drawing.TestData" />
  </ItemGroup>

</Project>
