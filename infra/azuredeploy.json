{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Azure Static Web App hosting Tellurian Trains Drawing, plus a user-assigned managed identity that GitHub Actions logs in as with OpenID Connect (no stored credentials)."
  },
  "parameters": {
    "name": {
      "type": "string",
      "defaultValue": "tellurian-trains-drawing",
      "metadata": { "description": "Name of the static web app; also the first part of its default host name." }
    },
    "location": {
      "type": "string",
      "defaultValue": "westeurope",
      "allowedValues": [ "westeurope", "centralus", "eastus2", "westus2", "eastasia" ],
      "metadata": { "description": "Regions where Static Web Apps can be created (North Europe is not one of them). The site itself is served globally." }
    },
    "sku": {
      "type": "string",
      "defaultValue": "Free",
      "allowedValues": [ "Free", "Standard" ]
    },
    "identityName": {
      "type": "string",
      "defaultValue": "id-trainsdrawing-deploy",
      "metadata": { "description": "User-assigned managed identity used by GitHub Actions to deploy." }
    },
    "identityLocation": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "gitHubRepository": {
      "type": "string",
      "defaultValue": "tellurianinteractive/Tellurian.Trains.Drawing",
      "metadata": { "description": "owner/name of the repository whose workflow may log in as the identity." }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "application": "Tellurian.Trains.Drawing",
        "repository": "https://github.com/tellurianinteractive/Tellurian.Trains.Drawing"
      }
    }
  },
  "variables": {
    "contributorRoleId": "b24988ac-6180-42a0-ab88-20f7382dd24c",
    "gitHubIssuer": "https://token.actions.githubusercontent.com",
    "audiences": [ "api://AzureADTokenExchange" ]
  },
  "resources": [
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2024-04-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('sku')]",
        "tier": "[parameters('sku')]"
      },
      "properties": {
        "stagingEnvironmentPolicy": "Enabled",
        "allowConfigFileUpdates": true,
        "deploymentAuthPolicy": "DeploymentToken"
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('identityName')]",
      "location": "[parameters('identityLocation')]",
      "tags": "[parameters('tags')]"
    },
    {
      "comments": "Deploy job (environment 'production').",
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}/github-production', parameters('identityName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
      ],
      "properties": {
        "issuer": "[variables('gitHubIssuer')]",
        "subject": "[format('repo:{0}:environment:production', parameters('gitHubRepository'))]",
        "audiences": "[variables('audiences')]"
      }
    },
    {
      "comments": "Pull request preview jobs (environment 'preview'). Federated credentials of one identity must be created one at a time, hence the dependency on the first.",
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}/github-preview', parameters('identityName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials', parameters('identityName'), 'github-production')]"
      ],
      "properties": {
        "issuer": "[variables('gitHubIssuer')]",
        "subject": "[format('repo:{0}:environment:preview', parameters('gitHubRepository'))]",
        "audiences": "[variables('audiences')]"
      }
    },
    {
      "comments": "Contributor on the static web app only: needed to read its deployment token at run time.",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.Web/staticSites/{0}', parameters('name'))]",
      "name": "[guid(resourceId('Microsoft.Web/staticSites', parameters('name')), parameters('identityName'), variables('contributorRoleId'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/staticSites', parameters('name'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('contributorRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "defaultHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/staticSites', parameters('name')), '2024-04-01').defaultHostname]"
    },
    "deployClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').clientId]"
    },
    "tenantId": {
      "type": "string",
      "value": "[subscription().tenantId]"
    },
    "subscriptionId": {
      "type": "string",
      "value": "[subscription().subscriptionId]"
    }
  }
}
