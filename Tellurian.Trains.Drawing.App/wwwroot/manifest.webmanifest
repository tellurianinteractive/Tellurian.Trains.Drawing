{
  "name": "Tellurian Trains Drawing",
  "short_name": "Trains Drawing",
  "id": "./",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#03173d",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    }
  ],
  "file_handlers": [
    {
      "action": "./spike/files",
      "accept": {
        "application/vnd.tellurian.drawing+json": [
          ".tdmodule",
          ".tdendprofile",
          ".tdhall",
          ".tdhallplan"
        ]
      }
    }
  ]
}
