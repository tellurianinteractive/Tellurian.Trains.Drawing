@using System.Globalization
@using Tellurian.Trains.Drawing.Components.Canvas
@using Tellurian.Trains.Drawing.Components.Properties
@using Tellurian.Trains.Drawing.Components.Rendering
@using Tellurian.Trains.Drawing.Components.Views
@using Tellurian.Trains.Drawing.Editing.Commands
@using Tellurian.Trains.Drawing.Editing.Input
@using Tellurian.Trains.Drawing.Editing.Modules
@using Tellurian.Trains.Drawing.Editing.Selection
@using Tellurian.Trains.Drawing.Editing.Snapping
@using Tellurian.Trains.Drawing.Editing.Tools
@using Tellurian.Trains.Drawing.Editing.Viewing
@using Tellurian.Trains.Schedules.Model.Geometry
@using Tellurian.Trains.Drawing.Model.Catalogue
@using Tellurian.Trains.Drawing.Model.EndProfiles
@using Tellurian.Trains.Drawing.Model.Modules
@using Tellurian.Trains.Drawing.Model.Tracks
@using static Tellurian.Trains.Schedules.Model.Layouts.ModuleExtensions
@implements IAsyncDisposable
@inject DrawingDocuments Documents
@inject IWorkbench Workbench
@inject SafeReload Reload
@inject TimeProvider Time
@inject IJSRuntime JS
@inject BrowserDialogs Dialogs

@* The module editor (Phase 6): for now its sections (MD-4, MD-4a), defined by section joints, polylines across the
   module, and the module's identification. End profiles are only assigned here, never compared for fit. *@
@if (_document is not null)
{
    <div class="editor-layout">
        <div class="editor-canvas">
            <ModuleView @ref="_moduleView" Json="@Draft.Json" Drawing="Shown.Module.Drawing" Tracks="@([.. Shown.Module.Tracks])" Standard="@Standard" EndProfiles="FindEndProfile" PrintTitle="@Draft.Name"
                        FitText="@T["ZoomToFit"]" Error="@T["CannotShow"]" IsEditable="true" ViewChanged="v => _view = v"
                        OnPointerDown="OnDown" OnPointerMove="OnMove" OnPointerUp="OnUp" OnKeyDown="OnKey">
                <Overlay>
                    @{
                        var joints = Shown.Module.Drawing.InternalJoints;
                        var half = _view.ToWorld(HandlePixels) / 2;
                    }
                    @if (_highlightedElement is { } highlighted && Shown.Module.Drawing.TrackElements.FirstOrDefault(t => t.Id == highlighted) is { } element)
                    {
                        foreach (var route in element.Routes())
                        {
                            <path class="editor-selected-joint editor-highlighted-track" d="@SvgPath.From(route)" />
                        }
                    }
                    @for (var j = 0; j < joints.Count; j++)
                    {
                        if (!IsSelected(j)) continue;
                        <path class="editor-selected-joint" d="@SvgPath.Polyline(joints[j].Points)" />
                    }
                    @for (var j = 0; j < joints.Count; j++)
                    {
                        var points = joints[j].Points;
                        for (var p = 0; p < points.Count; p++)
                        {
                            var at = points[p];
                            <rect class="@(_selection.Contains(ModuleItem.OfPoint(j, p)) ? "editor-handle selected" : "editor-handle")"
                                  x="@SvgPath.Number(at.X - half)" y="@SvgPath.Number(at.Y - half)" width="@SvgPath.Number(2 * half)" height="@SvgPath.Number(2 * half)" />
                        }
                    }
                    @if (_select.RubberBand is { } band)
                    {
                        <rect class="editor-rubber-band" x="@SvgPath.Number(band.Min.X)" y="@SvgPath.Number(band.Min.Y)" width="@SvgPath.Number(band.Width)" height="@SvgPath.Number(band.Height)" />
                    }
                    @if (_activeTool == ModuleTool.Joint && _jointPreview is { } preview)
                    {
                        <path class="editor-preview" d="@SvgPath.Polyline(preview.Points)" />
                    }
                    @if (_activeTool == ModuleTool.Select && _select.Snapped is { } snap)
                    {
                        <circle class="editor-snap" cx="@SvgPath.Number(snap.Point.X)" cy="@SvgPath.Number(snap.Point.Y)" r="@SvgPath.Number(_view.ToWorld(5))" />
                    }
                </Overlay>
            </ModuleView>
        </div>
        <aside class="editor-side">
            <section class="pane archive-pane" aria-label="@T["ArchivePane"]">
                <h2>@T["ArchivePane"] <HelpButton For="Archive" Title="@T["ArchivePane"]" AlignEnd="true" /></h2>
                @ArchiveContent
                <p class="detail" id="autosave">@AutosaveText</p>
            </section>
            <section class="pane edit-pane" aria-label="@T["EditPane"]">
                <h2>@T["EditPane"] <HelpButton For="ModuleEditor" Title="@T["EditPane"]" AlignEnd="true" /></h2>
                <div class="pane-buttons" role="toolbar">
                    @foreach (var tool in Enum.GetValues<ModuleTool>())
                    {
                        <button type="button" id="@($"tool-{tool.ToString().ToLowerInvariant()}")" class="@(tool == _activeTool ? "primary" : null)"
                                aria-pressed="@(tool == _activeTool)" disabled="@(tool == ModuleTool.Joint && _outline is null)" @onclick="() => Choose(tool)">@T[$"ModTool_{tool}"]</button>
                    }
                </div>
                @if (Catalogue is not null && ModuleRedraw.CanRedraw(_document.Current) && ModuleRedraw.HasCurve(_document.Current))
                {
                    <div class="pane-buttons">
                        <button type="button" id="flip-curve" @onclick="FlipCurveAsync">@T["FlipCurve"]</button>
                    </div>
                }
                <div class="pane-buttons">
                    <button type="button" id="undo" disabled="@(!_document.CanUndo)" title="Ctrl+Z" @onclick="Undo">@T["Undo"]</button>
                    <button type="button" id="redo" disabled="@(!_document.CanRedo)" title="Ctrl+Y" @onclick="Redo">@T["Redo"]</button>
                    <button type="button" id="delete" disabled="@_selection.IsEmpty" title="Delete" @onclick="DeleteSelection">@T["Delete"]</button>
                    <button type="button" id="print" @onclick="PrintAsync">@T["Print"]</button>
                </div>
                <p class="pane-help" aria-live="polite">@Status</p>
            </section>
            <section class="pane ends-pane" aria-label="@T["EndsPane"]">
                <h2>@T["EndsPane"] <HelpButton For="ModuleEnds" Title="@T["EndsPane"]" AlignEnd="true" /></h2>
                @{
                    var current = _document.Current;
                    var exits = current.Module.Drawing.Exits;
                    var canRedraw = Catalogue is not null && ModuleRedraw.CanRedraw(current);
                }
                <div class="property-grid">
                    @foreach (var exit in exits)
                    {
                        var label = exit.Label;
                        var profile = FindEndProfile(exit.EndProfile.Id);
                        <label class="property-label" for="@($"end-profile-{label}")">@T.Format("ExitEnd", label)</label>
                        <div class="end-choice">
                            <select id="@($"end-profile-{label}")" value="@exit.EndProfile.Id" disabled="@(!canRedraw)" @onchange="e => ChangeEndProfileAsync(label, e)">
                                @if (!EndProfileChoices.Any(p => p.Id == exit.EndProfile.Id))
                                {
                                    <option value="@exit.EndProfile.Id">@exit.EndProfile.Name</option>
                                }
                                @foreach (var choice in EndProfileChoices)
                                {
                                    <option value="@choice.Id">@ProfileText(choice)</option>
                                }
                            </select>
                            <button type="button" id="@($"flip-end-{label}")" disabled="@(!ModuleRedraw.CanFlip(profile))" title="@T["FlipEndHelp"]" @onclick="() => FlipEnd(label)">@T["FlipEnd"]</button>
                        </div>
                    }
                </div>
                @if (exits is [_, var second])
                {
                    <label class="inline"><input type="checkbox" id="endewender" checked="@current.Module.IsEndProfileSwitcher"
                           disabled="@(!exits.All(e => ModuleRedraw.CanFlip(FindEndProfile(e.EndProfile.Id))))" @onchange="() => FlipEnd(second.Label)" /> @T["IsEndewender"]</label>
                }
                @if (!canRedraw)
                {
                    <p class="pane-help" id="cannot-redraw">@T["CannotRedraw"]</p>
                }
            </section>
            <section class="pane sections-pane" aria-label="@T["SectionsPane"]">
                <h2>@T["SectionsPane"] <HelpButton For="ModuleSections" Title="@T["SectionsPane"]" AlignEnd="true" /></h2>
                @{
                    var drawing = _document.Current.Module.Drawing;
                    var main = drawing.MainPath;
                }
                <table class="plate-points module-sections">
                    <thead><tr><th>@T["Section"]</th>@if (main is not null) { <th>@T["SectionLength"]</th> }</tr></thead>
                    <tbody>
                        @foreach (var section in drawing.Sections)
                        {
                            <tr>
                                <td>@section.Label</td>
                                @if (main is not null)
                                {
                                    <td class="number" id="@($"section-length-{section.Label}")">@Mm(ModuleSections.LengthAlongTrack(section, main)) mm</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                @if (SelectedJoint is { } j && j < drawing.InternalJoints.Count)
                {
                    var joint = drawing.InternalJoints[j];
                    var points = joint.Points;
                    <h3 id="joint-title">@T.Format("JointBetween", joint.FirstSection, joint.SecondSection)</h3>
                    @if (main is not null)
                    {
                        <NumberField Label="@T["JointDistance"]" Help="@T.Help("JointDistance")" Value="ModuleSections.DistanceAlongTrack(joint, main)" Min="0" InvalidText="@T["InvalidNumber"]"
                                     ValueChanged="v => Apply(ModuleJoints.SetDistance(j, v))" />
                    }
                    <table class="plate-points joint-points">
                        <thead><tr><th>#</th><th>X (mm)</th><th>Y (mm)</th></tr></thead>
                        <tbody>
                            @for (var p = 0; p < points.Count; p++)
                            {
                                var index = p;
                                var at = points[p];
                                <tr class="@(_selection.Contains(ModuleItem.OfPoint(j, p)) ? "selected" : null)">
                                    <td><button type="button" class="link" @onclick="() => _selection.Select(ModuleItem.OfPoint(j, index))">@(p + 1)</button></td>
                                    <td><NumberField Label="" Unit="@null" Value="at.X" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(ModuleJoints.SetPoint(j, index, new(v, at.Y)))" /></td>
                                    <td><NumberField Label="" Unit="@null" Value="at.Y" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(ModuleJoints.SetPoint(j, index, new(at.X, v)))" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="pane-buttons">
                        <button type="button" id="add-joint-point" @onclick="() => AddPoint(j)">@T["AddJointPoint"]</button>
                        <button type="button" id="delete-joint-point" disabled="@(SelectedBend(j) is null)" @onclick="() => Apply(ModuleJoints.DeletePoint(j, SelectedBend(j)!.Value))">@T["DeleteJointPoint"]</button>
                    </div>
                    <p class="pane-help">@T["JointPointsHelp"]</p>
                }
                else if (_outline is null)
                {
                    <p class="pane-help" id="no-outline">@T["NoOutlineForSections"]</p>
                }
                else
                {
                    <p class="pane-help">@T["SectionsHelp"]</p>
                }
            </section>
            <ModuleTracksPane Content="_document.Current" Commands="TrackCommands" EndProfiles="FindEndProfile" Changed="Apply" ElementHighlighted="id => _highlightedElement = id" />
            <ModuleLocationPane Content="_document.Current" ModuleChanged="ChangeModule" />
            <ModulePropertiesPane Draft="Draft" Content="_document.Current" ModuleChanged="ChangeModule" />
        </aside>
    </div>
}

@code {
    private const double HandlePixels = 8;
    private static readonly double SnapPixels = SnapEngine.DefaultTolerancePixels;

    private readonly SelectionSet<ModuleItem> _selection = new();
    private readonly ModuleScene _scene = new();
    private readonly SnapEngine _snap = new(ModuleScene.IndexCellSize);
    private EditorDocument<ModuleFileContent>? _document;
    private EditorSession<ModuleFileContent>? _session;
    private SelectMoveTool<ModuleFileContent, ModuleItem> _select = default!;
    private ModuleTool _activeTool = ModuleTool.Select;
    private Viewport _view = Viewport.Fit(new BoundingBox(new(0, 0), new(1000, 1000)), 800, 500);
    private SegmentPath? _outline;
    private InternalJoint? _jointPreview;
    private string? _storageError;

    /// <summary>The track element that the Tracks pane points at, shown in the drawing.</summary>
    private Guid? _highlightedElement;

    /// <summary>The draft being edited.</summary>
    [Parameter, EditorRequired] public Draft Draft { get; set; } = default!;

    /// <summary>The module's standard, for the track colour.</summary>
    [Parameter] public ModuleStandard? Standard { get; set; }

    /// <summary>End profiles as they are now in the catalogue; the module file's own copies are used for the others.</summary>
    [Parameter] public Func<Guid, EndProfile?>? EndProfiles { get; set; }

    /// <summary>The catalogue, for choosing other end profiles and redrawing the module; without it, its ends can only be flipped.</summary>
    [Parameter] public DrawingCatalogue? Catalogue { get; set; }

    /// <summary>The host's file actions and status, shown in the Archive pane.</summary>
    [Parameter] public RenderFragment? ArchiveContent { get; set; }

    /// <summary>Raised after each autosave with the updated draft, e.g. for an unsaved-changes badge.</summary>
    [Parameter] public EventCallback<Draft> DraftChanged { get; set; }

    /// <summary>The module as edited now.</summary>
    public ModuleFileContent? Current => _document?.Current;

    /// <summary>Saves unsaved edits to the draft at once, e.g. before saving to a file.</summary>
    public async Task<bool> FlushAsync() => _session is null || await _session.FlushAsync();

    private EndProfile? FindEndProfile(Guid id) => EndProfiles?.Invoke(id) ?? _document?.Current.FindEndProfile(id);

    private double SnapTolerance => _view.ToWorld(SnapPixels);

    /// <summary>The commands of the Tracks pane; they measure the tracks with the standard's fouling distance.</summary>
    private ModuleTracks TrackCommands => new(Standard, FindEndProfile);

    /// <summary>A command that changes the module's shape, with its tracks measured again afterwards.</summary>
    private IEditCommand<ModuleFileContent> WithTracksMeasured(IEditCommand<ModuleFileContent> command) =>
        new EditCommand<ModuleFileContent>(command.Description, content => TrackCommands.Measured(command.Apply(content)));

    /// <summary>The module with a dragged selection shown where it is being moved.</summary>
    private ModuleFileContent Shown =>
        _select.DragOffset is { } offset ? ModuleJoints.Move([.. _selection.Items], offset).Apply(_document!.Current) : _document!.Current;

    private bool IsSelected(int joint) => _selection.Items.Any(i => i.Joint == joint);

    /// <summary>The joint of the selection, if it is one joint or points of one joint.</summary>
    private int? SelectedJoint => _selection.Items.Select(i => i.Joint).Distinct().ToList() is [var only] ? only : null;

    /// <summary>The selected bend of a joint, if one is selected; its ends aren't bends.</summary>
    private int? SelectedBend(int joint)
    {
        var count = _document!.Current.Module.Drawing.InternalJoints[joint].Points.Count;
        return _selection.Items.Where(i => i.Kind == ModuleItemKind.JointPoint && i.Joint == joint && i.Point > 0 && i.Point < count - 1)
            .Select(i => (int?)i.Point).FirstOrDefault();
    }

    private string Status => _activeTool == ModuleTool.Joint ? T["ModuleJointHelp"] : T["ModuleSelectHelp"];

    private string AutosaveText =>
        _storageError is not null ? T.Format("StorageError", _storageError)
        : _session?.Autosave.LastError is { } error ? T.Format("StorageError", error.Message)
        : _session?.Autosave.IsPending == true ? T["UnsavedChanges"]
        : T["SavedInBrowser"];

    protected override async Task OnInitializedAsync()
    {
        var content = Model.Files.DrawingFileSerializer.DeserializeModule(Draft.Json);
        // A module drawn before every module had a list of tracks gets one for its generated tracks.
        if (content.Module.WithGeneratedTrackList() is var listed && !ReferenceEquals(listed, content.Module))
            content = TrackCommands.Measured(content with { Module = listed });
        _document = new(content);
        _select = new(_document, _selection, _scene, _snap);
        _document.Changed += OnDocumentChanged;
        Refresh();
        var key = Draft.Id.ToString();
        try
        {
            if (await EditorSession<ModuleFileContent>.LoadStateAsync(Workbench, key) is { } state)
            {
                var items = ModuleScene.Items(content).ToHashSet();
                _selection.Set(state.Selection.Select(s => ModuleItem.TryParse(s, out var item) ? (ModuleItem?)item : null).OfType<ModuleItem>().Where(items.Contains));
            }
            _session = new(key, _document, SaveDraftAsync, Workbench, Reload, Time)
            {
                CaptureState = () => new(_view.Center.X, _view.Center.Y, _view.Scale, [.. _selection.Items.Select(i => i.ToString())]),
            };
            _session.Autosave.Saved += OnAutosaveChanged;
            _session.Autosave.SaveFailed += OnAutosaveFailed;
        }
        catch (StorageException ex)
        {
            _storageError = ex.Message;
        }
    }

    /// <summary>Stores the module with its end profiles and its measures derived again, e.g. its sections' lengths.</summary>
    private async Task SaveDraftAsync(ModuleFileContent content, CancellationToken cancellationToken)
    {
        ModuleFileContent file;
        try
        {
            file = ModuleFileContent.Create(content.Module, FindEndProfile).WithMeasuredTracks(Standard, FindEndProfile);
        }
        catch (KeyNotFoundException)
        {
            file = content;
        }
        var draft = await Documents.UpdateAsync(Draft.Id, Model.Files.DrawingFileSerializer.Serialize(file), cancellationToken);
        await InvokeAsync(() => DraftChanged.InvokeAsync(draft));
    }

    private void OnAutosaveChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private void OnAutosaveFailed(object? sender, Exception e) => _ = InvokeAsync(StateHasChanged);

    private void Choose(ModuleTool tool)
    {
        _select.Cancel();
        _jointPreview = null;
        _activeTool = tool;
    }

    private void OnDown(CanvasPointerEventArgs e)
    {
        if (_activeTool == ModuleTool.Joint)
        {
            if (e.Button == 0) Apply(ModuleJoints.Add(e.World));
            return;
        }
        _select.PointerDown(e.ToToolPointer(SnapTolerance));
    }

    private void OnMove(CanvasPointerEventArgs e)
    {
        if (_activeTool == ModuleTool.Joint)
        {
            _jointPreview = _outline is { } outline ? ModuleSections.Across(outline, _document!.Current.Module.Drawing.MainPath, e.World) : null;
            return;
        }
        _select.PointerMove(e.ToToolPointer(SnapTolerance));
    }

    private void OnUp(CanvasPointerEventArgs e)
    {
        if (_activeTool == ModuleTool.Select) _select.PointerUp(e.ToToolPointer(SnapTolerance));
    }

    private void OnKey(KeyboardEventArgs e)
    {
        var command = e.CtrlKey || e.MetaKey;
        if (command && e.Key is "z" or "Z" && !e.ShiftKey) Undo();
        else if (command && (e.Key is "y" or "Y" || (e.Key is "z" or "Z" && e.ShiftKey))) Redo();
        else if (e.Key == "Escape" && _activeTool == ModuleTool.Joint) Choose(ModuleTool.Select);
        else if (_activeTool == ModuleTool.Select && _select.KeyDown(e.Key)) return;
        else if (e.Key is "Delete" or "Backspace" && _activeTool == ModuleTool.Select) DeleteSelection();
    }

    private void Apply(IEditCommand<ModuleFileContent> command)
    {
        _select.Cancel();
        _document!.Apply(command);
    }

    private void Undo()
    {
        _select.Cancel();
        _document!.Undo();
    }

    private void Redo()
    {
        _select.Cancel();
        _document!.Redo();
    }

    private void DeleteSelection()
    {
        if (_selection.IsEmpty) return;
        var items = _selection.Items.ToList();
        _selection.Clear();
        Apply(ModuleJoints.Delete(items));
    }

    /// <summary>Adds a point after the selected point of the joint, or after its start, and selects it.</summary>
    private void AddPoint(int joint)
    {
        var after = _selection.Items.Where(i => i.Kind == ModuleItemKind.JointPoint && i.Joint == joint).Select(i => i.Point).DefaultIfEmpty(0).Max();
        var count = _document!.Current.Module.Drawing.InternalJoints[joint].Points.Count;
        after = Math.Min(after, count - 2);
        Apply(ModuleJoints.InsertPoint(joint, after));
        _selection.Select(ModuleItem.OfPoint(joint, after + 1));
    }

    /// <summary>A change from the Properties pane, as an undoable command.</summary>
    /// <summary>The end profiles an exit can have: those of the module's scale, of any standard (MD-5).</summary>
    private IEnumerable<EndProfile> EndProfileChoices =>
        Catalogue is null ? [] : Catalogue.EndProfiles.Where(p => p.Scale == _document!.Current.Module.Scale?.ShortName).OrderBy(p => p.Tracks.Count).ThenBy(p => p.Designation);

    private string ProfileText(EndProfile profile) =>
        $"{profile.Designation} ({(profile.Tracks.Count == 1 ? T["OneTrack"] : T.Format("TrackCount", profile.Tracks.Count))})";

    private async Task ChangeEndProfileAsync(string exitLabel, ChangeEventArgs e)
    {
        if (Catalogue is null || !Guid.TryParse(e.Value as string, out var id) || Catalogue.FindEndProfile(id) is not { } profile) return;
        if (_document!.Current.Module.Drawing.Exit(exitLabel)?.EndProfile.Id == id) return;
        if (ModuleRedraw.BendsWillChange(_document.Current, profile) && !await Dialogs.ConfirmAsync(T["BendsWillChange"]))
        {
            StateHasChanged();
            return;
        }
        _selection.Clear();
        Apply(WithTracksMeasured(ModuleEnds.SetEndProfile(exitLabel, profile, Catalogue)));
    }

    private async Task FlipCurveAsync()
    {
        if (Catalogue is null) return;
        if (ModuleRedraw.BendsWillChange(_document!.Current) && !await Dialogs.ConfirmAsync(T["BendsWillChange"])) return;
        _selection.Clear();
        Apply(WithTracksMeasured(ModuleEnds.FlipCurve(Catalogue)));
        _fitAfterRender = true;
    }

    private ModuleView? _moduleView;

    /// <summary>True when the module has been drawn in another shape, so the view is fitted to it once it is rendered.</summary>
    private bool _fitAfterRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_fitAfterRender || _moduleView is null) return;
        _fitAfterRender = false;
        await _moduleView.FitAsync();
    }

    private void FlipEnd(string exitLabel) => Apply(ModuleEnds.FlipEnd(exitLabel));

    private void ChangeModule(Module module) =>
        Apply(new EditCommand<ModuleFileContent>("Change properties", content => content with { Module = module }));

    private async Task PrintAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("print");
        }
        catch (JSException)
        {
            // Printing isn't available, e.g. in a restricted browser; nothing is lost.
        }
    }

    private void OnDocumentChanged(object? sender, EventArgs e)
    {
        // Indexes refer to the current joints, so a selection that no longer exists is cleared.
        var items = ModuleScene.Items(_document!.Current).ToHashSet();
        if (_selection.Items.Any(i => !items.Contains(i))) _selection.Clear();
        Refresh();
    }

    private void Refresh()
    {
        _outline = ModuleJoints.Outline(_document!.Current);
        _snap.Clear();
        _snap.AddRange(_scene.AllSnapTargets(_document.Current));
    }

    private static string Mm(double value) => NumberInput.Format(value, 0, CultureInfo.CurrentCulture);

    public async ValueTask DisposeAsync()
    {
        if (_document is not null) _document.Changed -= OnDocumentChanged;
        if (_session is not null)
        {
            _session.Autosave.Saved -= OnAutosaveChanged;
            _session.Autosave.SaveFailed -= OnAutosaveFailed;
            await _session.DisposeAsync();
        }
    }

    private enum ModuleTool
    {
        Select,
        Joint,
    }
}
