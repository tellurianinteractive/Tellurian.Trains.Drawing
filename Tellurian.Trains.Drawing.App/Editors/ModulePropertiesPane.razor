@using static Tellurian.Trains.Schedules.Model.Layouts.LayoutPartCopying
@using System.Globalization
@using Tellurian.Trains.Drawing.Components.Properties
@using Tellurian.Trains.Drawing.Model.Modules
@inject DrawingDocuments Documents

@* The properties of a module drawing (MD-2): how it is identified, by prefix and number or by a name, and its owners. On its own, each change
   is stored in the draft at once (autosave); in the module editor, which passes Content, each change goes to the editor
   as ModuleChanged, so it can be undone. Problems are shown but don't stop the change, so the fields can be filled in
   any order. *@
@if (_content is { } content)
{
    var module = content.Module;
    <section class="pane module-properties" aria-label="@T["Properties"]">
        <h2>@T["Properties"] <HelpButton For="ModuleProperties" Title="@T["Properties"]" AlignEnd="true" /></h2>
        <div class="property-grid">
            <TextField Label="@T["ModulePrefix"]" Value="@module.Prefix" ValueChanged="v => ApplyAsync(module.WithPrefix(v))" />
            <TextField Label="@T["ModuleNumber"]" Value="@module.Number?.ToString(CultureInfo.CurrentCulture)" ValueChanged="SetNumberAsync" />
            <TextField Label="@T["Name"]" Value="@module.Name" ValueChanged="v => ApplyAsync(module.WithName(v))" />
            <TextField Label="@T["ModuleOwners"]" Help="@T["ModuleOwnersHelp"]" Value="@module.ModuleOwners" ValueChanged="v => ApplyAsync(module.WithModuleOwners(v))" />
            <TextField Label="@T["PackageLabel"]" Help="@T["PackageLabelHelp"]" Value="@module.PackageLabel" ValueChanged="v => ApplyAsync(module.With(c => c.PackageLabel = string.IsNullOrWhiteSpace(v) ? null : v.Trim()))" />
        </div>
        @{ var problems = Problems(module).ToList(); }
        @if (problems.Count > 0)
        {
            <ul class="error module-problems" role="alert">
                @foreach (var problem in problems)
                {
                    <li>@problem</li>
                }
            </ul>
        }
        <p class="pane-help">@T["ModuleIdentificationHelp"]</p>
        <RevisionLogList Log="@Model.Files.DrawingRevisionLog.Read(Draft.Json)" Title="@T["RevisionLog"]" EmptyText="@T["NoRevisions"]" />
        @if (_message is not null)
        {
            <p class="error" role="alert">@_message</p>
        }
    </section>
}

@code {
    private ModuleFileContent? _content;
    private string? _shownJson;
    private bool _numberInvalid;
    private string? _message;

    [Parameter, EditorRequired] public Draft Draft { get; set; } = default!;
    [Parameter] public EventCallback<Draft> DraftChanged { get; set; }

    /// <summary>The module as edited by an editor; its changes then go to <see cref="ModuleChanged"/> instead of the draft.</summary>
    [Parameter] public ModuleFileContent? Content { get; set; }

    /// <summary>Raised with the changed module when <see cref="Content"/> is given.</summary>
    [Parameter] public EventCallback<Module> ModuleChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (Content is not null)
        {
            _content = Content;
            return;
        }
        if (Draft.Json == _shownJson) return;
        _shownJson = Draft.Json;
        try
        {
            _content = DrawingFileSerializer.DeserializeModule(Draft.Json);
        }
        catch (DrawingFileException)
        {
            _content = null;
        }
    }

    private IEnumerable<string> Problems(Module module)
    {
        if (_numberInvalid) yield return T["ModuleProblem_FremoNumberOutOfRange"];
        foreach (var problem in ModuleValidation.Validate(module).Where(p => !(_numberInvalid && p.Code == ModuleProblemCode.FremoNumberOutOfRange)))
            yield return T[$"ModuleProblem_{problem.Code}"];
    }

    private async Task SetNumberAsync(string? text)
    {
        if (_content is null) return;
        if (text is null)
        {
            _numberInvalid = false;
            await ApplyAsync(_content.Module.WithNumber(null));
        }
        else if (int.TryParse(text, NumberStyles.Integer, CultureInfo.CurrentCulture, out var number))
        {
            _numberInvalid = false;
            await ApplyAsync(_content.Module.WithNumber(number));
        }
        else
        {
            _numberInvalid = true;
        }
    }

    private async Task ApplyAsync(Module module)
    {
        if (_content is null) return;
        _message = null;
        if (Content is not null)
        {
            await ModuleChanged.InvokeAsync(module);
            return;
        }
        var content = _content with { Module = module };
        try
        {
            var draft = await Documents.UpdateAsync(Draft.Id, DrawingFileSerializer.Serialize(content));
            _content = content;
            _shownJson = draft.Json;
            await DraftChanged.InvokeAsync(draft);
        }
        catch (Exception ex) when (ex is StorageException or KeyNotFoundException)
        {
            _message = T.Format("StorageError", ex.Message);
        }
    }
}
