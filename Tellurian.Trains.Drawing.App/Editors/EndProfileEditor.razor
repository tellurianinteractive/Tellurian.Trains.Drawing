@using System.Globalization
@using Tellurian.Trains.Drawing.Components.Canvas
@using Tellurian.Trains.Drawing.Components.Properties
@using Tellurian.Trains.Drawing.Components.Rendering
@using Tellurian.Trains.Drawing.Components.Views
@using Tellurian.Trains.Drawing.Editing.Commands
@using Tellurian.Trains.Drawing.Editing.EndProfiles
@using Tellurian.Trains.Drawing.Editing.Input
@using Tellurian.Trains.Drawing.Editing.Selection
@using Tellurian.Trains.Drawing.Editing.Snapping
@using Tellurian.Trains.Drawing.Editing.Tools
@using Tellurian.Trains.Drawing.Editing.Viewing
@using Tellurian.Trains.Drawing.Geometry
@using Tellurian.Trains.Drawing.Model
@using Tellurian.Trains.Drawing.Model.EndProfiles
@implements IAsyncDisposable
@inject DrawingDocuments Documents
@inject IWorkbench Workbench
@inject SafeReload Reload
@inject TimeProvider Time

@* The end profile editor (Phase 5, EP-1…EP-7): end view with tools, a property panel and live derived properties. *@
@if (_document is not null)
{
    <div class="toolbar" role="toolbar">
        @foreach (var tool in Enum.GetValues<EndProfileTool>())
        {
            <button type="button" id="@($"tool-{tool.ToString().ToLowerInvariant()}")" class="@(tool == _activeTool ? "primary" : null)"
                    aria-pressed="@(tool == _activeTool)" @onclick="() => Choose(tool)">@T[$"EpTool_{tool}"]</button>
        }
        @if (_activeTool is EndProfileTool.Outline or EndProfileTool.GroundLine)
        {
            <label class="inline"><input type="checkbox" id="arc-mode" checked="@(ActivePath.Mode == PathStepMode.TangentArc)" @onchange="ToggleArc" /> @T["ArcMode"]</label>
        }
    </div>
    <div class="toolbar">
        <button type="button" id="undo" disabled="@(!_document.CanUndo)" title="Ctrl+Z" @onclick="Undo">@T["Undo"]</button>
        <button type="button" id="redo" disabled="@(!_document.CanRedo)" title="Ctrl+Y" @onclick="Redo">@T["Redo"]</button>
        <button type="button" id="delete" disabled="@_selection.IsEmpty" title="Delete" @onclick="DeleteSelection">@T["Delete"]</button>
        <button type="button" id="mirror-holes" @onclick="MirrorHoles">@T["MirrorScrewHoles"]</button>
        <button type="button" id="zoom-fit" @onclick="() => _canvas!.ZoomToAsync(EndProfileContent.Bounds(_document.Current))">@T["ZoomToFit"]</button>
        <span class="detail" id="autosave">@AutosaveText</span>
    </div>

    <div class="editor-layout">
        <div class="editor-canvas">
            <DrawingCanvas @ref="_canvas" @bind-Viewport="_view" Label="@_document.Current.Designation"
                           OnPointerDown="OnDown" OnPointerMove="OnMove" OnPointerUp="OnUp" OnKeyDownCallback="OnKey">
                <ChildContent>
                    <EndProfileContent Profile="Shown" TrackColor="@TrackColor" RailTopText="@T["RailTop"]" TextSize="_view.ToWorld(12)" Selected="_selection.Items" />
                </ChildContent>
                <Overlay>
                    @if (_select.RubberBand is { } band)
                    {
                        <rect class="editor-rubber-band" x="@SvgPath.Number(band.Min.X)" y="@SvgPath.Number(band.Min.Y)" width="@SvgPath.Number(band.Width)" height="@SvgPath.Number(band.Height)" />
                    }
                    @if (ActivePathOrNull?.Preview is { } preview)
                    {
                        <path class="editor-preview" d="@SvgPath.From(preview)" />
                    }
                    @if (ActivePlaceOrNull?.Preview is { } place)
                    {
                        <circle class="editor-place" cx="@SvgPath.Number(place.X)" cy="@SvgPath.Number(place.Y)" r="@SvgPath.Number(_activeTool == EndProfileTool.Track ? 2 : EndProfileCommands.DefaultScrewHoleDiameter / 2)" />
                    }
                    @if (Snapped is { } snap)
                    {
                        <circle class="editor-snap" cx="@SvgPath.Number(snap.Point.X)" cy="@SvgPath.Number(snap.Point.Y)" r="@SvgPath.Number(_view.ToWorld(5))" />
                    }
                </Overlay>
            </DrawingCanvas>
        </div>
        <aside class="editor-side">
            <PropertyPanel Title="@SelectionTitle">
                @switch (SingleSelected)
                {
                    case { Kind: EndProfileItemKind.Track } item when item.Index < _document.Current.Tracks.Count:
                        var track = _document.Current.Tracks[item.Index];
                        <NumberField Label="@T["Offset"]" Value="track.Offset" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(EndProfileCommands.SetTrack(item.Index, track with { Offset = v }))" />
                        <NumberField Label="@T["Gauge"]" Value="track.Gauge" Unit="mm" Min="1" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(EndProfileCommands.SetTrack(item.Index, track with { Gauge = v }))" />
                        <TextField Label="@T["Label"]" Value="@track.Label" ValueChanged="v => Apply(EndProfileCommands.SetTrack(item.Index, track with { Label = v }))" />
                        break;
                    case { Kind: EndProfileItemKind.ScrewHole } item when item.Index < _document.Current.ScrewHoles.Count:
                        var hole = _document.Current.ScrewHoles[item.Index];
                        <NumberField Label="X" Value="hole.Center.X" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(EndProfileCommands.SetScrewHole(item.Index, hole with { Center = new(v, hole.Center.Y) }))" />
                        <NumberField Label="Y" Value="hole.Center.Y" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(EndProfileCommands.SetScrewHole(item.Index, hole with { Center = new(hole.Center.X, v) }))" />
                        <NumberField Label="@T["Diameter"]" Value="hole.Diameter" Min="0.5" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(EndProfileCommands.SetScrewHole(item.Index, hole with { Diameter = v }))" />
                        break;
                    case { Kind: EndProfileItemKind.Dowel } item when item.Index < _document.Current.Dowels.Count:
                        var dowel = _document.Current.Dowels[item.Index];
                        <NumberField Label="X" Value="dowel.Center.X" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(EndProfileCommands.SetDowel(item.Index, dowel with { Center = new(v, dowel.Center.Y) }))" />
                        <NumberField Label="Y" Value="dowel.Center.Y" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(EndProfileCommands.SetDowel(item.Index, dowel with { Center = new(dowel.Center.X, v) }))" />
                        <NumberField Label="@T["Diameter"]" Value="dowel.Diameter" Min="0.5" InvalidText="@T["InvalidNumber"]" ValueChanged="v => Apply(EndProfileCommands.SetDowel(item.Index, dowel with { Diameter = v }))" />
                        break;
                    case null when _selection.IsEmpty:
                        var profile = _document.Current;
                        <TextField Label="@T["Designation"]" Value="@profile.Designation" ValueChanged="v => { if (!string.IsNullOrWhiteSpace(v)) Apply(EndProfileCommands.SetProperties(p => p with { Designation = v })); }" />
                        <TextField Label="@T["Scale"]" Value="@profile.Scale" ReadOnly="true" />
                        <TextField Label="@T["Standards"]" Value="@string.Join(", ", profile.Standards.Select(s => s.Name))" ReadOnly="true" />
                        <TextField Label="@T["ScrewHolePattern"]" Value="@profile.ScrewHolePattern" ValueChanged="v => Apply(EndProfileCommands.SetProperties(p => p with { ScrewHolePattern = v }))" />
                        <TextField Label="@T["Field_SourceTitle"]" Value="@profile.Source?.Title" ValueChanged="v => Apply(EndProfileCommands.SetProperties(p => p with { Source = WithTitle(p.Source, v) }))" />
                        <TextField Label="@T["Field_SourceUrl"]" Value="@profile.Source?.Url" ValueChanged="v => Apply(EndProfileCommands.SetProperties(p => p with { Source = WithUrl(p.Source, v) }))" />
                        break;
                    default:
                        <p class="property-note">@T.Format("SelectedCount", _selection.Count)</p>
                        break;
                }
            </PropertyPanel>

            <section class="derived" aria-label="@T["Derived"]">
                <h2>@T["Derived"]</h2>
                <dl class="properties">
                    <dt>@T["PlateSize"]</dt>
                    <dd id="plate-size">@(_derived.PlateBounds.IsEmpty ? "–" : $"{Mm(_derived.PlateWidth)} × {Mm(_derived.PlateHeight)} mm")</dd>
                    <dt>@T["Tracks"]</dt>
                    <dd id="track-count">@_derived.TrackCount</dd>
                    @if (_derived.TrackCount > 0)
                    {
                        <dt>@T["Offsets"]</dt>
                        <dd>@string.Join("; ", _derived.TrackOffsets.Select(Mm)) mm</dd>
                    }
                    @if (_derived.TrackCentreDistances.Count > 0)
                    {
                        <dt>c/c</dt>
                        <dd id="centre-distances">@string.Join("; ", _derived.TrackCentreDistances.Select(Mm)) mm</dd>
                    }
                    <dt>@T["ScrewHoles"]</dt>
                    <dd id="screw-hole-count">@_document.Current.ScrewHoles.Count</dd>
                    <dt>@T["Symmetry"]</dt>
                    <dd id="symmetry" class="@(_derived.IsSymmetric ? "symmetric" : "asymmetric")">
                        @(_derived.IsSymmetric ? T["Symmetric"] : T.Format("AsymmetricIn", AsymmetricText))
                    </dd>
                </dl>
            </section>
        </aside>
    </div>
    <p class="detail editor-status" aria-live="polite">@Status</p>
}

@code {
    private static readonly double SnapPixels = SnapEngine.DefaultTolerancePixels;

    private readonly SelectionSet<EndProfileItem> _selection = new();
    private readonly EndProfileScene _scene = new();
    private readonly SnapEngine _snap = new(EndProfileScene.IndexCellSize);
    private EditorDocument<EndProfile>? _document;
    private EditorSession<EndProfile>? _session;
    private SelectMoveTool<EndProfile, EndProfileItem> _select = default!;
    private PathTool<EndProfile> _outline = default!;
    private PathTool<EndProfile> _ground = default!;
    private PlaceTool<EndProfile> _screwHole = default!;
    private PlaceTool<EndProfile> _track = default!;
    private EndProfileTool _activeTool = EndProfileTool.Select;
    private DrawingCanvas? _canvas;
    private Viewport _view = default!;
    private EndProfileProperties _derived = default!;
    private string? _storageError;

    /// <summary>The draft being edited.</summary>
    [Parameter, EditorRequired] public Draft Draft { get; set; } = default!;

    /// <summary>The standard's track colour; the default without it.</summary>
    [Parameter] public string? TrackColor { get; set; }

    /// <summary>Raised after each autosave with the updated draft, e.g. for an unsaved-changes badge.</summary>
    [Parameter] public EventCallback<Draft> DraftChanged { get; set; }

    /// <summary>The profile as edited now.</summary>
    public EndProfile? Current => _document?.Current;

    /// <summary>Saves unsaved edits to the draft at once, e.g. before saving to a file.</summary>
    public async Task<bool> FlushAsync() => _session is null || await _session.FlushAsync();

    private double Tolerance => _view.ToWorld(SnapPixels);

    /// <summary>The profile with a dragged selection shown where it is being moved.</summary>
    private EndProfile Shown => _select.DragOffset is { } offset ? EndProfileCommands.Move([.. _selection.Items], offset).Apply(_document!.Current) : _document!.Current;

    private ITool Active => _activeTool switch
    {
        EndProfileTool.Outline => _outline,
        EndProfileTool.GroundLine => _ground,
        EndProfileTool.ScrewHole => _screwHole,
        EndProfileTool.Track => _track,
        _ => _select,
    };

    private PathTool<EndProfile> ActivePath => _activeTool == EndProfileTool.GroundLine ? _ground : _outline;
    private PathTool<EndProfile>? ActivePathOrNull => _activeTool is EndProfileTool.Outline or EndProfileTool.GroundLine ? ActivePath : null;
    private PlaceTool<EndProfile>? ActivePlaceOrNull => _activeTool switch { EndProfileTool.ScrewHole => _screwHole, EndProfileTool.Track => _track, _ => null };

    private SnapResult? Snapped => ActivePathOrNull?.Snapped ?? ActivePlaceOrNull?.Snapped ?? (_activeTool == EndProfileTool.Select ? _select.Snapped : null);

    private EndProfileItem? SingleSelected => _selection.Count == 1 ? _selection.Items[0] : null;

    private string SelectionTitle => SingleSelected is { } item ? T[$"EpItem_{item.Kind}"] : T["EndProfileProperties"];

    /// <summary>The elements that differ from their mirror image, as shown in the symmetry indicator (EP-7).</summary>
    private static readonly FitDifferences[] SymmetryElements =
        [FitDifferences.TrackPositions, FitDifferences.ScrewHoles, FitDifferences.GroundLine, FitDifferences.Outline, FitDifferences.Dowels];

    private string AsymmetricText =>
        string.Join(", ", SymmetryElements.Where(d => _derived.AsymmetricElements.HasFlag(d)).Select(d => T[$"Difference_{d}"]));

    private string Status => _activeTool switch
    {
        EndProfileTool.Outline => T[_outline.IsDrawing ? "PathHelpDrawing" : "OutlineHelp"],
        EndProfileTool.GroundLine => T[_ground.IsDrawing ? "PathHelpDrawing" : "GroundLineHelp"],
        EndProfileTool.ScrewHole => T["ScrewHoleHelp"],
        EndProfileTool.Track => T["TrackHelp"],
        _ => T["EndProfileSelectHelp"],
    };

    private string AutosaveText =>
        _storageError is not null ? T.Format("StorageError", _storageError)
        : _session?.Autosave.LastError is { } error ? T.Format("StorageError", error.Message)
        : _session?.Autosave.IsPending == true ? T["UnsavedChanges"]
        : T["SavedInBrowser"];

    protected override async Task OnInitializedAsync()
    {
        var profile = Model.Files.DrawingFileSerializer.DeserializeEndProfile(Draft.Json);
        _document = new(profile);
        _view = Viewport.Fit(EndProfileContent.Bounds(profile), 800, 400);
        _select = new(_document, _selection, _scene, _snap);
        _outline = new(_document, _snap, EndProfileCommands.SetOutline) { RequiresClosed = true };
        _ground = new(_document, _snap, EndProfileCommands.SetGroundLine) { AllowsClosed = false };
        _screwHole = new(_document, _snap, EndProfileCommands.AddScrewHole);
        _track = new(_document, _snap, p => EndProfileCommands.AddTrack(p.X, new() { Offset = 0, Gauge = profile.Tracks.FirstOrDefault()?.Gauge ?? 16.5 }))
        {
            Constrain = p => new(p.X, 0),
        };
        _document.Changed += OnDocumentChanged;
        Refresh();
        var key = Draft.Id.ToString();
        try
        {
            if (await EditorSession<EndProfile>.LoadStateAsync(Workbench, key) is { } state)
            {
                _view = _view with { Center = new(state.CenterX, state.CenterY), Scale = state.Scale };
                _selection.Set(state.Selection.Select(s => EndProfileItem.TryParse(s, out var item) ? (EndProfileItem?)item : null).OfType<EndProfileItem>()
                    .Where(i => EndProfileScene.Items(profile).Contains(i)));
            }
            _session = new(key, _document, SaveDraftAsync, Workbench, Reload, Time)
            {
                CaptureState = () => new(_view.Center.X, _view.Center.Y, _view.Scale, [.. _selection.Items.Select(i => i.ToString())]),
            };
            _session.Autosave.Saved += OnAutosaveChanged;
            _session.Autosave.SaveFailed += OnAutosaveFailed;
        }
        catch (StorageException ex)
        {
            _storageError = ex.Message;
        }
    }

    private async Task SaveDraftAsync(EndProfile profile, CancellationToken cancellationToken)
    {
        var draft = await Documents.UpdateAsync(Draft.Id, Model.Files.DrawingFileSerializer.Serialize(profile), cancellationToken);
        await InvokeAsync(() => DraftChanged.InvokeAsync(draft));
    }

    private void OnAutosaveChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private void OnAutosaveFailed(object? sender, Exception e) => _ = InvokeAsync(StateHasChanged);

    private void Choose(EndProfileTool tool)
    {
        Active.Cancel();
        _activeTool = tool;
    }

    private void ToggleArc(ChangeEventArgs e)
    {
        var mode = e.Value is true ? PathStepMode.TangentArc : PathStepMode.Line;
        _outline.Mode = mode;
        _ground.Mode = mode;
    }

    private void OnDown(CanvasPointerEventArgs e) => Active.PointerDown(e.ToToolPointer(Tolerance));

    private void OnMove(CanvasPointerEventArgs e)
    {
        _snap.GridSpacing = NiceSteps.GridSpacing(_view.Scale);
        Active.PointerMove(e.ToToolPointer(Tolerance));
    }

    private void OnUp(CanvasPointerEventArgs e) => Active.PointerUp(e.ToToolPointer(Tolerance));

    private void OnKey(KeyboardEventArgs e)
    {
        var command = e.CtrlKey || e.MetaKey;
        if (command && e.Key is "z" or "Z" && !e.ShiftKey) Undo();
        else if (command && (e.Key is "y" or "Y" || (e.Key is "z" or "Z" && e.ShiftKey))) Redo();
        else if (Active.KeyDown(e.Key)) return;
        else if (e.Key is "Delete" or "Backspace" && _activeTool == EndProfileTool.Select) DeleteSelection();
    }

    private void Apply(IEditCommand<EndProfile> command)
    {
        Active.Cancel();
        _document!.Apply(command);
    }

    private void Undo()
    {
        Active.Cancel();
        _document!.Undo();
    }

    private void Redo()
    {
        Active.Cancel();
        _document!.Redo();
    }

    private void DeleteSelection()
    {
        if (_selection.IsEmpty) return;
        var items = _selection.Items.ToList();
        _selection.Clear();
        Apply(EndProfileCommands.Delete(items));
    }

    private void MirrorHoles() => Apply(EndProfileCommands.MirrorScrewHoles(FitTolerances.Default.Joint));

    private void OnDocumentChanged(object? sender, EventArgs e)
    {
        // Indexes refer to the current lists, so a selection that no longer exists is cleared.
        var items = EndProfileScene.Items(_document!.Current).ToHashSet();
        if (_selection.Items.Any(i => !items.Contains(i))) _selection.Clear();
        Refresh();
    }

    private void Refresh()
    {
        _snap.Clear();
        _snap.AddRange(_scene.AllSnapTargets(_document!.Current));
        _derived = EndProfileAnalysis.Analyze(_document.Current);
    }

    private static DocumentReference? WithTitle(DocumentReference? source, string? title) =>
        title is null && source?.Url is null ? null : (source ?? new()) with { Title = title };

    private static DocumentReference? WithUrl(DocumentReference? source, string? url) =>
        url is null && source?.Title is null ? null : (source ?? new()) with { Url = url };

    private static string Mm(double value) => NumberInput.Format(value, 1, CultureInfo.CurrentCulture);

    public async ValueTask DisposeAsync()
    {
        if (_document is not null) _document.Changed -= OnDocumentChanged;
        if (_session is not null)
        {
            _session.Autosave.Saved -= OnAutosaveChanged;
            _session.Autosave.SaveFailed -= OnAutosaveFailed;
            await _session.DisposeAsync();
        }
    }

    private enum EndProfileTool
    {
        Select,
        Outline,
        GroundLine,
        Track,
        ScrewHole,
    }
}
