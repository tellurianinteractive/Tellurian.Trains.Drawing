<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <!-- AOT only in Release: Debug builds use the interpreter for a fast inner loop. Requires the wasm-tools workload. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Tellurian.Localization" Version="1.5.0" />
    <PackageReference Include="Tellurian.Utilities" Version="1.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tellurian.Trains.Drawing.Components\Tellurian.Trains.Drawing.Components.csproj" />
  </ItemGroup>

  <!-- Markdown documents shown in the app (release notes, later help texts), embedded so they work offline. -->
  <ItemGroup>
    <!-- English in RELEASENOTES.md, translations in RELEASENOTES.<language>.md. WithCulture="false" keeps the
         translations in the main assembly instead of satellite assemblies. -->
    <EmbeddedResource Include="..\RELEASENOTES*.md" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
