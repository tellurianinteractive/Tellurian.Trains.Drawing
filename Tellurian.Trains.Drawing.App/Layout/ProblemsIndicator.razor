@using Tellurian.Trains.Drawing.App.Catalogue
@using Tellurian.Trains.Drawing.App.Settings
@using Tellurian.Trains.Drawing.Model.Catalogue
@inject CatalogueProblems Catalogue
@inject SettingsService Settings
@implements IDisposable

@* The problems indicator in the top bar, as in the Planning app: a green check when all is well, a yellow sign
   for warnings, a red sign for errors, with the count. Clicking it lists them, errors first; clicking one opens
   the place to correct it. Drawing problems join later (VA). *@
<div class="problems-indicator @StateClass">
    <button type="button" class="indicator-button" id="problems-button" title="@T["Problems"]" aria-label="@T["Problems"]" @onclick="Toggle">
        <i class="fa-solid @IconClass"></i>
        @if (Count > 0)
        {
            <span class="badge">@Count</span>
        }
    </button>

    @if (open)
    {
        <div class="panel-backdrop" @onclick="Close"></div>
        <div class="problems-panel" role="dialog" aria-labelledby="problems-title">
            <header>
                <h2 id="problems-title">@T["Problems"]</h2>
                <button type="button" class="close" title="@T["Close"]" aria-label="@T["Close"]" @onclick="Close"><i class="fa-solid fa-xmark"></i></button>
            </header>
            @if (Count == 0)
            {
                <p class="empty">@T["NoProblems"]</p>
            }
            else
            {
                <ul>
                    @foreach (var problem in Catalogue.Problems)
                    {
                        <li class="error"><a href="@Href(problem)" @onclick="Close"><b>@Subject(problem)</b>: @Message(problem.Problem)</a></li>
                    }
                    @if (NoUserName)
                    {
                        <li class="warning" id="no-user-name"><a href="@Pages.SettingsPage.Url" @onclick="Close">@T["Warning_NoUserName"]</a></li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    private bool open;
    private bool settingsRead;
    private string? userName;

    /// <summary>Saves aren't recorded in the revision log without a user name (EX-10).</summary>
    private bool NoUserName => settingsRead && userName is null;

    private int Count => Catalogue.Problems.Count + (NoUserName ? 1 : 0);

    private string StateClass =>
        Catalogue.Problems.Count > 0 ? "has-problems" : NoUserName ? "has-warnings" : "no-problems";

    private string IconClass =>
        Catalogue.Problems.Count > 0 ? "fa-circle-exclamation" : NoUserName ? "fa-triangle-exclamation" : "fa-circle-check";

    protected override async Task OnInitializedAsync()
    {
        Catalogue.Changed += OnChanged;
        Settings.Changed += OnSettingsChanged;
        await ReadSettingsAsync();
        if (!Catalogue.IsChecked) await Catalogue.CheckAsync();
    }

    private async Task ReadSettingsAsync()
    {
        try
        {
            userName = (await Settings.GetAsync()).UserName;
            settingsRead = true;
        }
        catch (StorageException)
        {
            // The settings page reports storage problems.
        }
    }

    private void Toggle() => open = !open;

    private void Close() => open = false;

    private string Subject(CatalogueEntryProblem problem) => problem.Kind switch
    {
        CatalogueEntryKind.Standard => $"{T["Standard"]} {Catalogue.Catalogue.FindStandard(problem.Id)?.ShortName}",
        CatalogueEntryKind.AddOn => $"{T["AddOn"]} {Catalogue.Catalogue.AddOns.FirstOrDefault(a => a.Id == problem.Id)?.ShortName}",
        _ => $"{T["Override"]} {EndProfileName(problem.Id)} – {EndProfileName(problem.SecondId)}",
    };

    private string EndProfileName(Guid? id) =>
        id is { } profileId && Catalogue.Catalogue.FindEndProfile(profileId) is { } profile ? profile.Designation : T["UnknownEndProfile"];

    private string Message(CatalogueProblem problem) => T.Format($"Problem_{problem.Code}", T[$"Field_{problem.Property}"]);

    private static string Href(CatalogueEntryProblem problem) => problem.Kind switch
    {
        CatalogueEntryKind.Standard => $"catalogue/standard/{problem.Id}",
        CatalogueEntryKind.AddOn => $"catalogue/addon/{problem.Id}",
        _ => $"catalogue/override?first={problem.Id}&second={problem.SecondId}",
    };

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnSettingsChanged() => InvokeAsync(async () =>
    {
        await ReadSettingsAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Catalogue.Changed -= OnChanged;
        Settings.Changed -= OnSettingsChanged;
    }
}
