@page "/settings"
@using System.Globalization
@using Tellurian.Trains.Drawing.App.Settings
@using Tellurian.Trains.Drawing.Model.Catalogues
@inject SettingsService Settings
@inject Tellurian.Trains.Drawing.App.Catalogues.CatalogueService Catalogues
@inject IWorkbench Workbench
@inject IFileService Files
@inject BrowserEnvironment Browser
@inject SafeReload Reload

@* The user's settings (AP-8): kept in this browser, never written to drawing or catalogue files. They can be exported
   to a settings file of their own and imported again, e.g. when the browser has forgotten them. *@
<PageTitle>@T["Settings"]</PageTitle>

<h1>@T["Settings"] <HelpButton For="Settings" /></h1>

@if (message is not null)
{
    <p class="error" role="alert">@message</p>
}
@if (form is not null)
{
    <form class="form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <label>
            <span>@T["Field_UserName"]</span>
            <input id="userName" @bind="form.UserName" autocomplete="name" />
            <small class="note">@T["UserNameHelp"]</small>
        </label>
        <label>
            <span>@T["Field_Country"]</span>
            <select id="country" @bind="form.CountryId">
                <option value="">@T["NoCountry"]</option>
                @foreach (var country in Countries.All)
                {
                    <option value="@country.Id">@country.EnglishName</option>
                }
            </select>
            <small class="note">@T["CountryHelp"]</small>
        </label>
        <label>
            <span>@T["Field_Scale"]</span>
            <select id="scale" @bind="form.Scale">
                <option value="">@T["AllScales"]</option>
                @foreach (var scale in scales)
                {
                    <option value="@scale.ShortName">@scale</option>
                }
            </select>
            <small class="note">@T["ScaleHelp"]</small>
        </label>
        <label>
            <span>@T["Field_ApiKey"]</span>
            <span class="secret">
                <input id="apiKey" type="@(showApiKey ? "text" : "password")" @bind="form.ApiKey" autocomplete="off" spellcheck="false" />
                <button type="button" id="toggle-api-key" @onclick="() => showApiKey = !showApiKey">@(showApiKey ? T["Hide"] : T["Show"])</button>
            </span>
            <small class="note">@T["ApiKeyHelp"]</small>
        </label>

        <div class="toolbar">
            <button type="submit" class="primary" id="save-settings">@T["Save"]</button>
            @if (status is not null)
            {
                <span class="note" id="settings-saved" role="status">@status</span>
            }
        </div>
    </form>

    <section class="settings-file" aria-labelledby="settings-file-title">
        <h2 id="settings-file-title">@T["SettingsFileTitle"]</h2>
        <p class="note">@T["SettingsFileHelp"]</p>
        <div class="toolbar">
            <button type="button" id="export-settings" @onclick="ExportAsync">@T["ExportSettings"]</button>
            <button type="button" id="import-settings" @onclick="ImportAsync">@T["ImportSettings"]</button>
        </div>
    </section>
}
@if (persisted is { } isPersisted)
{
    <section class="storage-status" aria-labelledby="storage-title">
        <h2 id="storage-title">@T["StorageTitle"]</h2>
        @if (isPersisted)
        {
            <p id="storage-persisted" class="note">@T["StoragePersisted"]</p>
        }
        else
        {
            <p id="storage-not-persisted" class="warning">@T["StorageNotPersisted"]</p>
            <div class="toolbar">
                <button type="button" id="request-persistence" @onclick="RequestPersistenceAsync">@T["StorageAskToKeep"]</button>
            </div>
            @if (persistenceRefused)
            {
                <p id="storage-refused" class="note" role="status">@T["StorageRefused"]</p>
            }
        }
        @* The advice for this browser: open when the browser doesn't keep the data, at hand otherwise, since some
           browsers' privacy settings delete the data when they close even though it is kept. *@
        <KeepDataHelp Browser="Browser.Capabilities.Kind" Open="!isPersisted" />
    </section>
}

@code {
    public const string Url = "settings";

    private Form? form;
    private IReadOnlyList<Scale> scales = [];
    private bool showApiKey;
    private string? status;
    private string? message;

    /// <summary>Whether the browser keeps the settings and drafts; null until known, or if it can't be told.</summary>
    private bool? persisted;
    private bool persistenceRefused;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            scales = ScaleChoices.Of(await Catalogues.GetAsync());
            ShowInForm(await Settings.GetAsync());
            persisted = await Workbench.IsPersistedAsync();
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private void ShowInForm(UserSettings settings) =>
        form = new() { UserName = settings.UserName, CountryId = settings.CountryId, Scale = settings.Scale, ApiKey = settings.ApiKey };

    private async Task RequestPersistenceAsync()
    {
        try
        {
            persisted = await Workbench.RequestPersistenceAsync();
            persistenceRefused = persisted == false;
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private async Task SaveAsync()
    {
        if (await SaveFormAsync()) status = T["SettingsSaved"];
    }

    /// <summary>Saves the settings as shown; false if they couldn't be saved.</summary>
    private async Task<bool> SaveFormAsync()
    {
        if (form is null) return false;
        try
        {
            await Settings.SaveAsync(new() { UserName = form.UserName, CountryId = form.CountryId, Scale = form.Scale, ApiKey = form.ApiKey });
            persisted = await Workbench.IsPersistedAsync();
            message = null;
            return true;
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
            return false;
        }
    }

    /// <summary>Saves the settings as shown, then writes them with the UI language to a settings file.</summary>
    private async Task ExportAsync()
    {
        status = null;
        if (!await SaveFormAsync()) return;
        try
        {
            var json = SettingsFile.Write(await Settings.GetAsync(), CultureInfo.CurrentUICulture.Name);
            if (await Files.SaveAsync(json, $"{T["SettingsFileName"]}.json", handleId: null, saveAs: true) is not null) status = T["SettingsExported"];
        }
        catch (FileOperationException ex)
        {
            message = T.Format("FileError", ex.Message);
        }
    }

    /// <summary>Reads a settings file and saves its settings; a different UI language in it is applied by reloading.</summary>
    private async Task ImportAsync()
    {
        status = null;
        try
        {
            var picked = await Files.OpenAsync([DrawingFileFormat.JsonExtension], multiple: false);
            if (picked is not [var opened, ..]) return;
            if (SettingsFile.Read(opened.Text) is not { } file)
            {
                message = T.Format("SettingsFileInvalid", opened.Name);
                return;
            }
            await Settings.SaveAsync(file.Settings);
            ShowInForm(await Settings.GetAsync());
            persisted = await Workbench.IsPersistedAsync();
            message = null;
            status = T["SettingsImported"];
            if (file.Culture is { } culture && culture != CultureInfo.CurrentUICulture.Name && AppLanguages.All.Select(AppLanguages.CultureOf).Contains(culture))
                message = (await Reload.ReloadAsync(culture))?.Message;
        }
        catch (FileOperationException ex)
        {
            message = T.Format("FileError", ex.Message);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private sealed class Form
    {
        public string? UserName { get; set; }
        public int? CountryId { get; set; }
        public string? Scale { get; set; }
        public string? ApiKey { get; set; }
    }
}
