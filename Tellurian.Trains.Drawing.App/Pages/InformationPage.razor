@page "/"
@page "/information"
@inject ContentDocuments Content

@* The information page: the app's first page, also opened from the app name in the top menu.
   Its text is the localised Markdown document Content/Information.md in the Translations project. *@
<PageTitle>@T["AppName"]</PageTitle>

<article class="information">
    <h1>@T["InformationTitle"]</h1>

    @((MarkupString)html)

    <div class="toolbar">
        <a class="button primary" id="get-started" href="@Home.Url">@T["InformationContinue"]</a>
    </div>
</article>

@code {
    public const string Url = "";

    private string html = "";

    protected override async Task OnInitializedAsync() =>
        html = await Content.HtmlAsync(ContentDocuments.Information, System.Globalization.CultureInfo.CurrentUICulture);
}
