@page "/new/module"
@using Tellurian.Trains.Drawing.App.Catalogues
@using Tellurian.Trains.Drawing.Model.Catalogues
@using Tellurian.Trains.Drawing.Model.EndProfiles
@using Tellurian.Trains.Drawing.Model.Modules
@using static Tellurian.Trains.Schedules.Model.Layouts.ModuleExtensions
@inject CatalogueService Catalogues
@inject DrawingDocuments Documents
@inject NavigationManager Navigation

<PageTitle>@T["NewModuleTitle"]</PageTitle>

<h1>@T["NewModuleTitle"]</h1>

@if (catalogue is null)
{
    @if (message is not null)
    {
        <p class="error" role="alert">@message</p>
    }
}
else
{
    <form class="form" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <fieldset class="choices">
            <legend>@T["Template"]</legend>
            @foreach (var kind in Enum.GetValues<ModuleTemplateKind>())
            {
                <label>
                    <input type="radio" name="kind" checked="@(form.Kind == kind)" @onchange="() => form.Kind = kind" />
                    @T[$"Template_{kind}"]
                </label>
            }
        </fieldset>

        <fieldset class="identification">
            <legend>@T["ModuleIdentification"]</legend>
            <small class="note">@T["ModuleIdentificationHelp"]</small>
            <label>
                <span>@T["ModulePrefix"]</span>
                <input id="prefix" @bind="form.Prefix" maxlength="10" autocomplete="off" />
            </label>
            <label>
                <span>@T["ModuleNumber"]</span>
                <input id="number" type="number" min="@ModuleValidation.MinFremoNumber" max="@ModuleValidation.MaxFremoNumber" step="1" @bind="form.Number" />
            </label>
            <label>
                <span>@T["Name"]</span>
                <input id="name" @bind="form.Name" />
            </label>
            <label>
                <span>@T["ModuleOwners"]</span>
                <input id="owners" @bind="form.ModuleOwners" autocomplete="off" />
                <small class="note">@T["ModuleOwnersHelp"]</small>
            </label>
        </fieldset>

        <label>
            <span>@T["Standard"]</span>
            <select id="standard" value="@form.StandardId" @onchange="SelectStandard">
                @foreach (var standard in catalogue.Standards.OrderBy(s => s.ShortName))
                {
                    <option value="@standard.Id">@standard.ShortName</option>
                }
            </select>
        </label>

        <label>
            <span>@T["FirstEndProfile"]</span>
            <select id="endProfile" @bind="form.EndProfileId">
                @foreach (var profile in EndProfiles)
                {
                    <option value="@profile.Id">@ProfileText(profile)</option>
                }
            </select>
        </label>

        <label>
            <span>@T["SecondEndProfile"]</span>
            <select id="secondEndProfile" @bind="form.SecondEndProfileId">
                <option value="@Guid.Empty">@T["SameEndProfile"]</option>
                @foreach (var profile in EndProfilesOfScale)
                {
                    <option value="@profile.Id">@ProfileText(profile)</option>
                }
            </select>
        </label>

        <label class="inline"><input type="checkbox" id="endewender" @bind="form.IsEndewender" /> @T["IsEndewender"]</label>

        @if (form.Kind != ModuleTemplateKind.Curve)
        {
            <label>
                <span>@T["StraightLength"]</span>
                <DecimalInput id="straight" @bind-Value="form.Straight" InvalidText="@T["InvalidNumber"]" />
            </label>
        }
        @if (form.Kind != ModuleTemplateKind.Straight)
        {
            <label>
                <span>@T["Radius"]</span>
                <DecimalInput id="radius" @bind-Value="form.Radius" InvalidText="@T["InvalidNumber"]" />
            </label>
            <label>
                <span>@T["Angle"]</span>
                <DecimalInput id="angle" @bind-Value="form.Angle" Quantity="Tellurian.Trains.Drawing.Editing.Input.Quantity.Angle" InvalidText="@T["InvalidNumber"]" />
            </label>
            <label>
                <span>@T["CurveDirection"]</span>
                <select @bind="form.CurveDirection">
                    @foreach (var direction in Enum.GetValues<CurveDirection>())
                    {
                        <option value="@direction">@T[$"CurveDirection_{direction}"]</option>
                    }
                </select>
            </label>
        }
        @if (form.Kind == ModuleTemplateKind.StraightAndCurve)
        {
            <label>
                <span>@T["StraightPosition"]</span>
                <select @bind="form.StraightPosition">
                    @foreach (var position in Enum.GetValues<StraightPosition>())
                    {
                        <option value="@position">@T[$"StraightPosition_{position}"]</option>
                    }
                </select>
            </label>
        }
        <label>
            <span>@T["Width"]</span>
            <DecimalInput id="width" @bind-Value="form.Width" placeholder="@T["WidthHint"]" InvalidText="@T["InvalidNumber"]" />
        </label>

        @if (errors.Count > 0)
        {
            <ul class="error" role="alert">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        }
        @if (notes.Count > 0)
        {
            <div class="notes" role="status">
                <p>@(created is null ? T["NotDrawn"] : T["DrawnWithNotes"])</p>
                <ul>
                    @foreach (var note in notes)
                    {
                        <li>@note.Message</li>
                    }
                </ul>
            </div>
        }

        <div class="toolbar">
            @if (created is null)
            {
                <button type="submit" class="primary" disabled="@(creating is not null)">@T["Create"]</button>
            }
            else
            {
                <a class="button primary" href="@DrawingPage.Url(created.Id)">@T["OpenDrawing"]</a>
            }
            <a class="button" href="@Home.Url">@T["Cancel"]</a>
        </div>
    </form>
    @if (creating is not null)
    {
        <div class="busy-overlay">
            <p class="busy-message" role="status" aria-live="polite">@T.Format("CreatingModule", creating)</p>
        </div>
    }
}

@code {
    private Catalogue? catalogue;
    private readonly Form form = new();
    private IReadOnlyList<string> errors = [];
    private IReadOnlyList<AutoDrawNote> notes = [];
    private Draft? created;
    private string? message;
    /// <summary>The name of the module being created, while it is.</summary>
    private string? creating;

    /// <summary>Long enough for the browser to show the wait message before the work starts.</summary>
    private static readonly TimeSpan ShowMessageDelay = TimeSpan.FromMilliseconds(1);

    private IEnumerable<EndProfile> EndProfiles =>
        catalogue is null ? [] : catalogue.EndProfilesOf(form.StandardId).WithOutline().OrderBy(p => p.Tracks.Count).ThenBy(p => p.Designation);

    /// <summary>End B may have an end profile of any standard of the same scale, e.g. FREMO at end A and MMM at end B.</summary>
    private IEnumerable<EndProfile> EndProfilesOfScale =>
        catalogue?.FindStandard(form.StandardId) is { } standard
            ? catalogue.EndProfiles.WithOutline().Where(p => p.Scale == standard.ScaleName).OrderBy(p => p.Tracks.Count).ThenBy(p => p.Designation)
            : [];

    private string ProfileText(EndProfile profile) =>
        $"{profile.Designation} ({(profile.Tracks.Count == 1 ? T["OneTrack"] : T.Format("TrackCount", profile.Tracks.Count))})";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            catalogue = await Catalogues.GetForChoicesAsync();
            form.Name = T["NewModuleName"];
            // Start with a standard that has end profiles, so the form can be submitted as it is.
            var standards = catalogue.Standards.OrderBy(s => s.ShortName).ToList();
            var standard = standards.FirstOrDefault(s => catalogue.EndProfilesOf(s.Id ?? Guid.Empty).WithOutline().Any()) ?? standards.FirstOrDefault();
            if (standard is not null) UseStandard(standard);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private void SelectStandard(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value as string, out var id) && catalogue?.FindStandard(id) is { } standard) UseStandard(standard);
    }

    private void UseStandard(ModuleStandard standard)
    {
        form.StandardId = standard.Id ?? Guid.Empty;
        form.EndProfileId = EndProfiles.FirstOrDefault()?.Id ?? Guid.Empty;
        if (!EndProfilesOfScale.Any(p => p.Id == form.SecondEndProfileId)) form.SecondEndProfileId = Guid.Empty;
        form.Radius = standard.DefaultCurveRadius ?? Form.FallbackRadius;
    }

    private async Task CreateAsync()
    {
        notes = [];
        errors = Validate().ToList();
        if (errors.Count > 0 || catalogue is null) return;

        creating = new Tellurian.Trains.Schedules.Model.Layouts.Module { Name = form.Name, Prefix = form.Prefix, Number = form.Number }.Title;
        StateHasChanged();
        // Drawing a module takes a while in the browser; let it show the wait message first.
        await Task.Delay(ShowMessageDelay);
        try
        {
            await CreateModuleAsync(catalogue);
        }
        finally
        {
            creating = null;
        }
    }

    private async Task CreateModuleAsync(Catalogue catalogue)
    {
        var template = new ModuleTemplate
        {
            Kind = form.Kind,
            Name = form.Name.Trim(),
            Number = form.Number,
            Prefix = form.Prefix,
            ModuleOwners = form.ModuleOwners,
            Standard = catalogue.FindStandard(form.StandardId)!,
            EndProfile = catalogue.FindEndProfile(form.EndProfileId)!,
            SecondEndProfile = catalogue.FindEndProfile(form.SecondEndProfileId),
            IsEndProfileSwitcher = form.IsEndewender,
            Straight = form.Straight ?? 0,
            Radius = form.Radius ?? 0,
            Angle = form.Angle ?? 0,
            Width = form.Width,
            CurveDirection = form.CurveDirection,
            StraightPosition = form.StraightPosition,
        };
        var result = template.Create(catalogue);
        notes = result.Notes;
        if (result.Module is null)
        {
            // Never fail silently: without notes, at least say that nothing was drawn.
            if (notes.Count == 0) errors = [T["NotDrawn"]];
            return;
        }
        try
        {
            var json = DrawingFileSerializer.Serialize(ModuleFileContent.Create(result.Module, catalogue.FindEndProfile));
            created = await Documents.CreateAsync(json);
            if (notes.Count == 0) Navigation.NavigateTo(DrawingPage.Url(created.Id));
        }
        catch (StorageException ex)
        {
            errors = [T.Format("StorageError", ex.Message)];
        }
    }

    private IEnumerable<string> Validate()
    {
        foreach (var problem in ModuleValidation.Validate(form.Name, form.Prefix, form.Number)) yield return T[$"ModuleProblem_{problem.Code}"];
        if (catalogue?.FindEndProfile(form.EndProfileId) is null) yield return T["EndProfileRequired"];
        if (form.Kind != ModuleTemplateKind.Curve && form.Straight is not > 0) yield return T.Format("MustBePositive", T["StraightLength"]);
        if (form.Kind != ModuleTemplateKind.Straight)
        {
            if (form.Radius is not > 0) yield return T.Format("MustBePositive", T["Radius"]);
            if (form.Angle is not (> 0 and <= 360)) yield return T.Format("AngleRange", T["Angle"]);
        }
        if (form.Width is <= 0) yield return T.Format("MustBePositive", T["Width"]);
    }

    private sealed class Form
    {
        public const double FallbackRadius = 2000;

        public ModuleTemplateKind Kind { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Prefix { get; set; }
        public int? Number { get; set; }
        public string? ModuleOwners { get; set; }
        public Guid StandardId { get; set; }
        public Guid EndProfileId { get; set; }

        /// <summary><see cref="Guid.Empty"/>: the same as end A.</summary>
        public Guid SecondEndProfileId { get; set; }

        public bool IsEndewender { get; set; }
        public double? Straight { get; set; } = 1000;
        public double? Radius { get; set; } = FallbackRadius;
        public double? Angle { get; set; } = 30;
        public double? Width { get; set; }
        public CurveDirection CurveDirection { get; set; }
        public StraightPosition StraightPosition { get; set; }
    }
}
