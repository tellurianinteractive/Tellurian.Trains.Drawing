@page "/release-notes"
@using Tellurian.Trains.Drawing.App.Help

@* The release notes from RELEASENOTES.md, in English. Opened from the information page. *@
<PageTitle>@T["ReleaseNotes"]</PageTitle>

<article class="information release-notes">
    <h1>@T["ReleaseNotes"]</h1>
    @((MarkupString)MarkdownDocuments.Html(MarkdownDocuments.ReleaseNotes))
    <div class="toolbar">
        <a class="button primary" id="get-started" href="">@T["InformationContinue"]</a>
    </div>
</article>

@code {
    public const string Url = "release-notes";
}
