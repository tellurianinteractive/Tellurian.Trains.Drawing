@page "/catalogue/standard/new"
@page "/catalogue/standard/{Id:guid}"
@using Tellurian.Trains.Drawing.App.Catalogues
@using Tellurian.Trains.Drawing.Model
@using Tellurian.Trains.Drawing.Model.Catalogues
@inject CatalogueService Catalogues
@inject NavigationManager Navigation

<PageTitle>@Title</PageTitle>

<h1>@Title</h1>

@if (message is not null)
{
    <p class="error" role="alert">@message</p>
}
@if (catalogue is not null)
{
    @* Only what Module Draw uses (StandardFields); the standard's other values are kept as they came. *@
    <form class="form" @onsubmit="@(() => busy.RunAsync("save", SaveAsync))" @onsubmit:preventDefault>
        <label><span>@T["Field_ShortName"]</span><input id="shortName" @bind="form.ShortName" /></label>
        <label>
            <span>@T["Field_Scale"]</span>
            <select id="scale" @bind="form.Scale">
                @foreach (var scale in ScaleChoices.Of(catalogue))
                {
                    <option value="@scale.ShortName">@scale</option>
                }
            </select>
        </label>
        <label>
            <span>@T["Field_Countries"]</span>
            <input id="countries" @bind="form.Countries" placeholder="SE" />
            <small class="note">@T["CountriesHelp"]</small>
        </label>

        <ProblemList Problems="problems" />

        <div class="toolbar">
            <BusyButton Busy="busy" Key="save" Type="submit" Class="primary">@T["Save"]</BusyButton>
            <a class="button" href="catalogue">@T["Cancel"]</a>
        </div>
    </form>
}

@code {
    /// <summary>The IO action running, if any (BusyButton).</summary>
    private readonly BusyState busy = new();

    [Parameter] public Guid? Id { get; set; }

    private Catalogue? catalogue;

    /// <summary>The scale of a new standard when the catalogue has none: H0, the most common.</summary>
    private const string DefaultScale = "H0";
    private ModuleStandard? original;
    private Form form = new();
    private IReadOnlyList<CatalogueProblem> problems = [];
    private string? message;

    private string Title => Id is null ? T["NewStandard"] : T.Format("EditEntry", original?.ShortName ?? string.Empty);

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            catalogue = await Catalogues.GetAsync();
            original = Id is { } id ? catalogue.FindStandard(id) : null;
            if (Id is not null && original is null)
            {
                message = T["EntryNotFound"];
                catalogue = null;
                return;
            }
            form = original is null ? new() { Scale = catalogue.Scales.FirstOrDefault()?.ShortName ?? DefaultScale } : Form.From(original);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            problems = await Catalogues.SaveStandardAsync(form.ToStandard(original));
            if (problems.Count == 0) Navigation.NavigateTo("catalogue");
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private sealed class Form
    {
        public string ShortName { get; set; } = string.Empty;
        public string Scale { get; set; } = string.Empty;

        /// <summary>Two-letter country codes separated by commas or spaces, e.g. "SE, NO"; empty for all countries.</summary>
        public string? Countries { get; set; }

        public static Form From(ModuleStandard s) => new()
        {
            ShortName = s.ShortName,
            Scale = s.ScaleName,
            Countries = string.Join(", ", s.Countries ?? []),
        };

        /// <summary>The standard with the form's values; the properties the form doesn't show are kept from <paramref name="original"/>.</summary>
        public ModuleStandard ToStandard(ModuleStandard? original) =>
            (original ?? new ModuleStandard { Id = Guid.NewGuid(), ShortName = string.Empty }).With(edited =>
            {
                edited.ShortName = ShortName.Trim();
                edited.Scale = new() { ShortName = Scale };
                edited.Countries = [.. (Countries ?? string.Empty).Split([',', ' ', ';'], StringSplitOptions.RemoveEmptyEntries).Select(c => c.ToUpperInvariant()).Distinct()];
            });
    }
}
