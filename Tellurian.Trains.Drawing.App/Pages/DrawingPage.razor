@page "/drawing/{Id:guid}"
@inject IWorkbench Workbench
@inject DrawingDocuments Documents
@inject NavigationManager Navigation
@inject BrowserDialogs Dialogs
@inject Tellurian.Trains.Drawing.App.Catalogue.CatalogueService Catalogues
@using Tellurian.Trains.Drawing.Components.Views
@using Tellurian.Trains.Drawing.App.Editors

<PageTitle>@(draft?.Name ?? T["AppName"])</PageTitle>

@if (notFound)
{
    <p class="error">@T["DraftNotFound"]</p>
}
else if (draft is not null && draft.Kind == DrawingFileKind.EndProfile)
{
    <EndProfileEditor @ref="_endProfileEditor" @key="draft.Id" Draft="draft" TrackColor="@_trackColor" DraftChanged="d => draft = d">
        <ArchiveContent>
            <p class="archive-name"><b>@draft.Name</b> <span class="kind">@T[$"Kind_{draft.Kind}"]</span></p>
            <p class="detail">@(draft.FileName ?? T["NotSavedToFile"])</p>
            <div class="pane-buttons">
                <button type="button" class="primary" id="save" @onclick="() => SaveAsync(saveAs: false)">@(Documents.CanSaveInPlace ? T["Save"] : T["SaveDownload"])</button>
                @if (Documents.CanSaveInPlace)
                {
                    <button type="button" id="save-as" @onclick="() => SaveAsync(saveAs: true)">@T["SaveAs"]</button>
                }
                <button type="button" id="save-to-catalogue" @onclick="SaveToCatalogueAsync">@T["SaveToCatalogue"]</button>
                <button type="button" id="discard" @onclick="DiscardAsync">@T["Discard"]</button>
            </div>
            <p>
                @if (draft.HasUnsavedChanges)
                {
                    <span class="badge unsaved">@T["UnsavedChanges"]</span>
                }
                else
                {
                    <span class="badge saved">@T["Saved"]</span>
                }
            </p>
            @if (!Documents.CanSaveInPlace)
            {
                <p class="note">@T["DownloadNote"]</p>
            }
            @if (message is not null)
            {
                <p class="error" role="alert">@message</p>
            }
            @if (_status is not null)
            {
                <p class="status" role="status">@_status</p>
            }
        </ArchiveContent>
    </EndProfileEditor>
}
else if (draft is not null)
{
    <h1>@draft.Name</h1>
    <p class="kind">@T[$"Kind_{draft.Kind}"]</p>

    <div class="toolbar">
        <button type="button" class="primary" @onclick="() => SaveAsync(saveAs: false)">@(Documents.CanSaveInPlace ? T["Save"] : T["SaveDownload"])</button>
        @if (Documents.CanSaveInPlace)
        {
            <button type="button" @onclick="() => SaveAsync(saveAs: true)">@T["SaveAs"]</button>
        }
        <button type="button" @onclick="DiscardAsync">@T["Discard"]</button>
    </div>
    @if (!Documents.CanSaveInPlace)
    {
        <p class="note">@T["DownloadNote"]</p>
    }
    @if (message is not null)
    {
        <p class="error" role="alert">@message</p>
    }

    <dl class="properties">
        <dt>@T["File"]</dt>
        <dd>@(draft.FileName ?? T["NotSavedToFile"])</dd>
        <dt>@T["Changed"]</dt>
        <dd><time datetime="@draft.Modified.ToString("o")">@draft.Modified.ToLocalTime().ToString("g")</time></dd>
    </dl>
    <p class="status">
        @if (draft.HasUnsavedChanges)
        {
            <span class="badge unsaved">@T["UnsavedChanges"]</span>
        }
        else
        {
            <span class="badge saved">@T["Saved"]</span>
        }
    </p>

    <div class="drawing-view">
        @switch (draft.Kind)
        {
            case DrawingFileKind.Module:
                <ModuleView Json="@draft.Json" Standard="@_standard" Error="@T["CannotShow"]" />
                break;
            case DrawingFileKind.Hall:
                <HallView Json="@draft.Json" Error="@T["CannotShow"]" />
                break;
        }
    </div>
    <p class="note">@T["EditorComing"]</p>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Draft? draft;
    private bool notFound;
    private string? message;

    public static string Url(Guid id) => $"drawing/{id}";

    private Tellurian.Trains.Drawing.Model.Catalogue.ModuleStandard? _standard;

    /// <summary>The track colour of an end profile's first standard.</summary>
    private async Task<string?> TrackColorOfAsync(Draft? draft)
    {
        if (draft?.Kind != DrawingFileKind.EndProfile) return null;
        try
        {
            var profile = DrawingFileSerializer.DeserializeEndProfile(draft.Json);
            var catalogue = await Catalogues.GetAsync();
            return profile.Standards.Select(s => catalogue.FindStandard(s.Id)?.TrackColor).FirstOrDefault(c => c is not null);
        }
        catch (DrawingFileException)
        {
            return null;
        }
    }

    /// <summary>The standard of a module draft, for its track colour.</summary>
    private async Task<Tellurian.Trains.Drawing.Model.Catalogue.ModuleStandard?> StandardOfAsync(Draft? draft)
    {
        if (draft?.Kind != DrawingFileKind.Module) return null;
        try
        {
            var module = DrawingFileSerializer.DeserializeModule(draft.Json).Module;
            return (await Catalogues.GetAsync()).FindStandard(module.Standard.Id);
        }
        catch (DrawingFileException)
        {
            return null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            draft = await Workbench.GetDraftAsync(Id);
            notFound = draft is null;
            _standard = await StandardOfAsync(draft);
            _trackColor = await TrackColorOfAsync(draft);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private EndProfileEditor? _endProfileEditor;
    private string? _trackColor;

    /// <summary>Saves the profile being edited in the user's catalogue, so modules can use it (EP-1).</summary>
    private async Task SaveToCatalogueAsync()
    {
        message = null;
        try
        {
            if (_endProfileEditor?.Current is not { } profile) return;
            await _endProfileEditor.FlushAsync();
            await Catalogues.SaveEndProfileAsync(profile);
            message = null;
            _status = T.Format("SavedToCatalogue", profile.Designation);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private string? _status;

    private async Task SaveAsync(bool saveAs)
    {
        message = null;
        _status = null;
        try
        {
            if (_endProfileEditor is not null) await _endProfileEditor.FlushAsync();
            draft = await Documents.SaveAsync(Id, saveAs) ?? draft;
        }
        catch (FileOperationException ex)
        {
            message = T.Format("FileError", ex.Message);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private async Task DiscardAsync()
    {
        if (draft is null) return;
        try
        {
            if (draft.HasUnsavedChanges && !await Dialogs.ConfirmAsync(T.Format("DiscardUnsaved", draft.Name))) return;
            await Workbench.DeleteDraftAsync(draft.Id);
            Navigation.NavigateTo("");
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }
}
