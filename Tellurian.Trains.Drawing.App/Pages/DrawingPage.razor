@page "/drawing/{Id:guid}"
@inject IWorkbench Workbench
@inject DrawingDocuments Documents
@inject NavigationManager Navigation
@inject BrowserDialogs Dialogs
@inject Tellurian.Trains.Drawing.App.Catalogues.CatalogueService Catalogues
@using Tellurian.Trains.Drawing.Components.Properties
@using Tellurian.Trains.Drawing.Components.Views
@using Tellurian.Trains.Drawing.App.Editors
@using Tellurian.Trains.Drawing.Model.Catalogues

<PageTitle>@(draft?.Name ?? T["AppName"])</PageTitle>

@if (notFound)
{
    <p class="error">@T["DraftNotFound"]</p>
}
else if (draft is not null && _unreadable is not null)
{
    @* A draft that can't be read, e.g. saved by a development build in an earlier shape: no editor, only its file actions. *@
    <section class="pane archive-pane" aria-label="@T["ArchivePane"]">
        <h2>@T["ArchivePane"]</h2>
        <p class="error" role="alert" id="draft-unreadable">@T.Format("DraftUnreadable", _unreadable)</p>
        @ArchiveFragment(draft)
    </section>
}
else if (draft is not null && draft.Kind == DrawingFileKind.EndProfile)
{
    <EndProfileEditor @ref="_endProfileEditor" @key="draft.Id" Draft="draft" TrackColor="@_trackColor" DraftChanged="d => draft = d">
        <ArchiveContent>
            @ArchiveFragment(draft)
        </ArchiveContent>
    </EndProfileEditor>
}
else if (draft is not null && draft.Kind == DrawingFileKind.Hall)
{
    <HallEditor @ref="_hallEditor" @key="draft.Id" Draft="draft" DraftChanged="d => draft = d">
        <ArchiveContent>
            @ArchiveFragment(draft)
        </ArchiveContent>
    </HallEditor>
}
else if (draft is not null && draft.Kind == DrawingFileKind.Module)
{
    <ModuleEditor @ref="_moduleEditor" @key="draft.Id" Draft="draft" Standard="@_standard" EndProfiles="FindEndProfile" Catalogue="_catalogue" DraftChanged="d => draft = d">
        <ArchiveContent>
            @ArchiveFragment(draft)
        </ArchiveContent>
    </ModuleEditor>
}
else if (draft is not null)
{
    @* Other kinds of drawing have no editor yet: their file actions only. *@
    <section class="pane archive-pane" aria-label="@T["ArchivePane"]">
        <h2>@T["ArchivePane"]</h2>
        @ArchiveFragment(draft)
        <p class="pane-help">@T["EditorComing"]</p>
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>The file actions and status in the editors' Archive pane.</summary>
    private RenderFragment ArchiveFragment(Draft current) => @<text>
    <p class="archive-name"><b>@current.Name</b> <span class="kind">@T[$"Kind_{current.Kind}"]</span></p>
    <p class="detail">@(current.FileName ?? T["NotSavedToFile"])</p>
    <div class="pane-buttons">
        <button type="button" class="primary" id="save" @onclick="() => SaveAsync(saveAs: false)">@(Documents.CanSaveInPlace ? T["Save"] : T["SaveDownload"])</button>
        @if (Documents.CanSaveInPlace)
        {
            <button type="button" id="save-as" @onclick="() => SaveAsync(saveAs: true)">@T["SaveAs"]</button>
        }
        @if (current.Kind == DrawingFileKind.EndProfile)
        {
            <button type="button" id="save-to-catalogue" @onclick="SaveToCatalogueAsync">@T["SaveToCatalogue"]</button>
            @if (_endProfileEditor?.Current is { } shown && Tellurian.Trains.Drawing.App.Catalogues.CatalogueService.ModuleRegistryId(shown) is not null)
            {
                <button type="button" id="upload-to-registry" @onclick="UploadToRegistryAsync">@T["UploadToRegistry"]</button>
            }
        }
        <button type="button" id="discard" @onclick="DiscardAsync">@T["Discard"]</button>
    </div>
    <p>
        @if (current.HasUnsavedChanges)
        {
            <span class="badge unsaved">@T["UnsavedChanges"]</span>
        }
        else
        {
            <span class="badge saved">@T["Saved"]</span>
        }
    </p>
    @if (_updatedEndProfiles.Count > 0)
    {
        <p class="note" id="updated-end-profiles">@T.Format("EndProfilesUpdated", string.Join(", ", _updatedEndProfiles))</p>
    }
    @if (_missingEndProfiles.Count > 0)
    {
        <p class="note" id="missing-end-profiles">@T.Format("EndProfilesNotInCatalogue", string.Join(", ", _missingEndProfiles.Select(p => p.Designation)))</p>
        <div class="pane-buttons">
            <button type="button" id="save-missing-end-profiles" @onclick="SaveMissingEndProfilesAsync">@T["SaveToCatalogue"]</button>
        </div>
    }
    @if (!Documents.CanSaveInPlace)
    {
        <p class="note">@T["DownloadNote"]</p>
    }
    @if (message is not null)
    {
        <p class="error" role="alert">@message</p>
    }
    @if (_status is not null)
    {
        <p class="status" role="status">@_status</p>
    }
    </text>;

    private Draft? draft;
    private bool notFound;
    /// <summary>Why the draft can't be read, or null when it can.</summary>
    private string? _unreadable;
    private string? message;

    public static string Url(Guid id) => $"drawing/{id}";

    private ModuleStandard? _standard;
    private Catalogue? _catalogue;

    /// <summary>
    /// The end profile as it is now in the catalogue, so that changes such as a new short name show; the module
    /// view falls back to the copy embedded in the module file.
    /// </summary>
    private Tellurian.Trains.Schedules.Model.Layouts.EndProfiles.EndProfile? FindEndProfile(Guid id) => _catalogue?.FindEndProfile(id);

    /// <summary>The track colour of an end profile's first standard.</summary>
    private async Task<string?> TrackColorOfAsync(Draft? draft)
    {
        if (draft?.Kind != DrawingFileKind.EndProfile) return null;
        try
        {
            var profile = DrawingFileSerializer.DeserializeEndProfile(draft.Json);
            var catalogue = await Catalogues.GetAsync();
            return profile.Standards.Select(s => catalogue.FindStandard(s.Id)?.TrackColor).FirstOrDefault(c => c is not null);
        }
        catch (DrawingFileException)
        {
            return null;
        }
    }

    /// <summary>The standard of a module draft, for its track colour.</summary>
    private async Task<ModuleStandard?> StandardOfAsync(Draft? draft)
    {
        if (draft?.Kind != DrawingFileKind.Module) return null;
        try
        {
            var module = DrawingFileSerializer.DeserializeModule(draft.Json).Module;
            return module.Standard?.Id is { } standardId ? (await Catalogues.GetAsync()).FindStandard(standardId) : null;
        }
        catch (DrawingFileException)
        {
            return null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            // The draft is shown only when it is ready, so that an editor never starts from a module that is about to be updated.
            var loaded = await Workbench.GetDraftAsync(Id);
            _unreadable = loaded is null ? null : DrawingFileSerializer.ProblemOf(loaded.Json);
            if (_unreadable is not null)
            {
                draft = loaded;
                return;
            }
            _catalogue = loaded?.Kind == DrawingFileKind.Module ? await Catalogues.GetAsync() : null;
            if (loaded is not null && _catalogue is not null)
            {
                loaded = await WithCurrentEndProfilesAsync(loaded, _catalogue);
                _missingEndProfiles = MissingEndProfiles(loaded, _catalogue);
            }
            _standard = await StandardOfAsync(loaded);
            _trackColor = await TrackColorOfAsync(loaded);
            draft = loaded;
            notFound = draft is null;
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    /// <summary>The end profiles the module embeds that the catalogue doesn't have, which the user can save there.</summary>
    private IReadOnlyList<Tellurian.Trains.Schedules.Model.Layouts.EndProfiles.EndProfile> _missingEndProfiles = [];

    private static IReadOnlyList<Tellurian.Trains.Schedules.Model.Layouts.EndProfiles.EndProfile> MissingEndProfiles(Draft module, Catalogue catalogue)
    {
        try
        {
            return [.. DrawingFileSerializer.DeserializeModule(module.Json).EndProfiles.Where(p => catalogue.FindEndProfile(p.Id) is null)];
        }
        catch (DrawingFileException)
        {
            return [];
        }
    }

    /// <summary>Saves the module's end profiles that the catalogue lacks there, so other modules can use them.</summary>
    private async Task SaveMissingEndProfilesAsync()
    {
        message = null;
        try
        {
            var saved = _missingEndProfiles;
            await Catalogues.AddEndProfilesAsync(saved);
            _catalogue = await Catalogues.GetAsync();
            _missingEndProfiles = [];
            _status = T.Format("SavedToCatalogue", string.Join(", ", saved.Select(p => p.Designation)));
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    /// <summary>The designations of the end profiles that were updated from the catalogue when the module was opened.</summary>
    private IReadOnlyList<string> _updatedEndProfiles = [];

    /// <summary>
    /// The module draft with its embedded end profiles updated from <paramref name="catalogue"/> where they have
    /// changed there, so that the module's file gets them when it is saved; the draft then has unsaved changes.
    /// </summary>
    private async Task<Draft> WithCurrentEndProfilesAsync(Draft module, Catalogue catalogue)
    {
        try
        {
            var (merged, moved) = DrawingFileSerializer.DeserializeModule(module.Json).WithMergedEndProfiles(await Catalogues.GetEndProfileMergesAsync(), catalogue.FindEndProfile);
            var (content, updated) = merged.WithCurrentEndProfiles(catalogue.FindEndProfile);
            if (moved.Count == 0 && updated.Count == 0) return module;
            _updatedEndProfiles = [.. moved.Concat(updated).DistinctBy(p => p.Id).Select(p => p.Designation)];
            return await Documents.UpdateAsync(module.Id, DrawingFileSerializer.Serialize(content));
        }
        catch (DrawingFileException)
        {
            return module;
        }
    }

    private EndProfileEditor? _endProfileEditor;
    private HallEditor? _hallEditor;
    private ModuleEditor? _moduleEditor;
    private string? _trackColor;

    /// <summary>Saves the profile being edited in the user's catalogue, so modules can use it (EP-1).</summary>
    private async Task SaveToCatalogueAsync()
    {
        message = null;
        try
        {
            if (_endProfileEditor?.Current is not { } profile) return;
            await _endProfileEditor.FlushAsync();
            await Catalogues.SaveEndProfileAsync(profile);
            message = null;
            _status = T.Format("SavedToCatalogue", profile.Designation);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private string? _status;

    /// <summary>
    /// Saves the profile being edited in the Module Registry as a new revision (EX-11), and in the catalogue; for users
    /// whose API key may manage end profiles.
    /// </summary>
    private async Task UploadToRegistryAsync()
    {
        message = null;
        _status = null;
        try
        {
            if (_endProfileEditor?.Current is not { } profile) return;
            await _endProfileEditor.FlushAsync();
            var (result, uploaded) = await Catalogues.UploadToModuleRegistryAsync(profile);
            if (uploaded is not null)
            {
                _catalogue = await Catalogues.GetAsync();
                _status = T.Format("UploadedToRegistry", uploaded.Designation, uploaded.Revision);
                return;
            }
            message = result.Status switch
            {
                Tellurian.Trains.Drawing.App.Catalogues.EndProfileUploadStatus.NoApiKey => T["UploadNeedsApiKey"],
                Tellurian.Trains.Drawing.App.Catalogues.EndProfileUploadStatus.NotAllowed => T.Format("UploadNotAllowed", result.Message ?? string.Empty),
                Tellurian.Trains.Drawing.App.Catalogues.EndProfileUploadStatus.Conflict => T.Format("UploadConflict", result.Message ?? string.Empty),
                _ => T.Format("UploadRefused", result.Message ?? string.Empty),
            };
        }
        catch (Tellurian.Trains.Drawing.App.Catalogues.ModuleRegistryException ex)
        {
            message = T.Format("RegistryError", ex.Message);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private async Task SaveAsync(bool saveAs)
    {
        message = null;
        _status = null;
        try
        {
            if (_endProfileEditor is not null) await _endProfileEditor.FlushAsync();
            if (_hallEditor is not null) await _hallEditor.FlushAsync();
            if (_moduleEditor is not null) await _moduleEditor.FlushAsync();
            draft = await Documents.SaveAsync(Id, saveAs) ?? draft;
        }
        catch (FileOperationException ex)
        {
            message = T.Format("FileError", ex.Message);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }

    private async Task DiscardAsync()
    {
        if (draft is null) return;
        try
        {
            if (draft.HasUnsavedChanges && !await Dialogs.ConfirmAsync(T.Format("DiscardUnsaved", draft.Name))) return;
            await Workbench.DeleteDraftAsync(draft.Id);
            Navigation.NavigateTo(Home.Url);
        }
        catch (StorageException ex)
        {
            message = T.Format("StorageError", ex.Message);
        }
    }
}
