<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Domain model for Tellurian Trains drawings: end profiles, modules, halls, hall plans, joint fit rules, validation, file format and auto-drawing of modules.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tellurian.Trains.Schedules.Exporters.Drawing" Version="4.0.19" />
    <PackageReference Include="Tellurian.Trains.Schedules.Importers.Drawing" Version="4.0.19" />
    <PackageReference Include="Tellurian.Trains.Schedules.Model.Geometry" Version="4.0.19" />
    <PackageReference Include="Tellurian.Trains.Schedules.Model.Layouts" Version="4.0.19" />
    <PackageReference Include="Tellurian.Utilities" Version="1.3.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalogue\BuiltInCatalogue.catalogue.json" LogicalName="Tellurian.Trains.Drawing.Model.BuiltInCatalogue.catalogue.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tellurian.Trains.Drawing.Model.Tests" />
  </ItemGroup>

</Project>
