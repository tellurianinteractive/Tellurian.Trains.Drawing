<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Version>0.10.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <Company>Stefan Fjällemark</Company>
    <Copyright>© Stefan Fjällemark 2026</Copyright>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- NuGet metadata for the packable libraries (Model, Editing, Components), reused by the Module Registry. -->
  <PropertyGroup>
    <Authors>Stefan Fjällemark</Authors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tellurianinteractive/Tellurian.Trains.Drawing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tellurianinteractive/Tellurian.Trains.Drawing</RepositoryUrl>
    <PackageTags>model railway;FREMO;module;drawing;blazor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
