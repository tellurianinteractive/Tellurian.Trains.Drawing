<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Version>0.2.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <Company>Tellurian Interactive AB</Company>
    <Copyright>Copyright © Tellurian Interactive AB</Copyright>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- NuGet metadata for the packable libraries (Geometry, Model, Editing, Components), reused by the Module Registry. -->
  <PropertyGroup>
    <Authors>Stefan Fjällemark</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tellurianinteractive/Tellurian.Trains.Drawing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tellurianinteractive/Tellurian.Trains.Drawing</RepositoryUrl>
    <PackageTags>model railway;FREMO;module;drawing;blazor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
