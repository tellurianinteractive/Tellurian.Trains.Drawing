    <IsPackable>true</IsPackable>
    <Description>Blazor components for displaying and editing Tellurian Trains end profile, module and hall plan drawings.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tellurian.Trains.Drawing.Editing\Tellurian.Trains.Drawing.Editing.csproj" />
  </ItemGroup>

</Project>
