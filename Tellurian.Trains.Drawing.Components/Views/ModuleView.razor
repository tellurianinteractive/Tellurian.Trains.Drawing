@using Tellurian.Trains.Drawing.Components.Canvas
@using Tellurian.Trains.Drawing.Components.Rendering
@using Tellurian.Trains.Drawing.Editing.Viewing
@using Tellurian.Trains.Schedules.Model.Geometry
@using Tellurian.Trains.Drawing.Model.Catalogue
@using Tellurian.Trains.Drawing.Model.EndProfiles
@using Tellurian.Trains.Drawing.Model.Files
@using Tellurian.Trains.Drawing.Model.Modules
@using Tellurian.Trains.Drawing.Model.Tracks
@using static Tellurian.Trains.Schedules.Model.Layouts.ModuleExtensions

@* Plan view of a module (EX-8), in module coordinates; read-only and without JS, or the canvas of the module
   editor, which passes the drawing as edited, an overlay and pointer callbacks. *@
@if (_drawing is null)
{
    <p class="drawing-view-error">@Error</p>
}
else
{
    RenderFragment content =
        @<g class="md-content">
            @if (Show(ModuleLayers.OperatorSpaces))
            {
                @foreach (var space in _drawing.OperatorSpaces)
                {
                    <path class="md-operator-space" d="@SvgPath.From(space.Area)" />
                }
            }
            @if (Show(ModuleLayers.Sections))
            {
                @foreach (var section in _drawing.Sections)
                {
                    <path class="md-section" d="@SvgPath.From(section.Outline)" />
                }
                @foreach (var joint in _drawing.InternalJoints)
                {
                    <path class="md-internal-joint" d="@SvgPath.Polyline(joint.Points)" />
                }
            }
            @if (Show(ModuleLayers.DuckUnderAreas))
            {
                @foreach (var area in _drawing.DuckUnderAreas)
                {
                    <path class="md-duck-under" d="@SvgPath.From(area.Area)" />
                }
            }
            @if (Show(ModuleLayers.PublicSides))
            {
                @foreach (var side in PublicSidePaths())
                {
                    <path class="md-public-side" d="@SvgPath.From(side)" />
                }
            }
            @if (Show(ModuleLayers.Exits))
            {
                @foreach (var shade in _shades)
                {
                    <path class="@(shade.IsAboveRailTop ? "md-profile above" : "md-profile below")" d="@SvgPath.Polyline(shade.Corners, isClosed: true)" />
                }
            }
            @if (Show(ModuleLayers.EndPlates))
            {
                @foreach (var plate in _plates)
                {
                    <line class="md-end-plate" x1="@SvgPath.Number(plate.LeftCorner.X)" y1="@SvgPath.Number(plate.LeftCorner.Y)" x2="@SvgPath.Number(plate.RightCorner.X)" y2="@SvgPath.Number(plate.RightCorner.Y)" />
                }
            }
            @if (Show(ModuleLayers.Tracks))
            {
                <g class="md-tracks" style="@($"--track-color: {TrackColor}")">
                    @foreach (var track in _drawing.TrackElements)
                    {
                        @foreach (var route in track.Routes())
                        {
                            <path class="@(track.IsNarrowGauge ? "md-track narrow" : "md-track")" d="@SvgPath.From(route)" />
                        }
                    }
                </g>
            }
            @if (Show(ModuleLayers.TrackDesignations))
            {
                @foreach (var label in _trackLabels)
                {
                    <WorldText At="label.Pose.Position" Text="@label.Designation" Rotation="label.Pose.Heading" Size="MarkerSize" FontWeight="bold" Class="md-label md-track-designation" />
                }
            }
            @if (Show(ModuleLayers.Exits))
            {
                @* The end profile's short name along the plate, inside the module beyond the shading. Exit labels aren't drawn: they aren't marked on real modules. *@
                @foreach (var exit in _drawing.Exits)
                {
                    var nameSize = MarkerSize * ProfileNameRelativeSize;
                    @if (_profileNames.TryGetValue(exit.Label, out var name))
                    {
                        <WorldText At="exit.Pose.Position - exit.Pose.Forward * (name.Depth + nameSize)" Text="@name.Text" Size="nameSize" Rotation="exit.Pose.Heading + Angle.Quarter" FontWeight="bold" Class="md-label md-profile-name" />
                    }
                }
            }
            @if (Show(ModuleLayers.Name) && _name is { } moduleName && _namePlacement is { } placement)
            {
                <WorldText At="placement.Title" Text="@moduleName.Title" Size="placement.TitleSize" Rotation="placement.Rotation" FontWeight="bold" Class="md-label md-module-name" />
                @if (placement.Subtitle is { } ownerAt && placement.SubtitleSize is { } ownerSize)
                {
                    <WorldText At="ownerAt" Text="@moduleName.Owner" Size="ownerSize" Rotation="placement.Rotation" Class="md-label md-module-owner" />
                }
            }
            @if (Show(ModuleLayers.Labels))
            {
                @foreach (var label in _drawing.Labels.Where(l => !string.IsNullOrWhiteSpace(l.Text)))
                {
                    <WorldText At="label.Pose.Position" Text="@label.Text" Rotation="label.Pose.Heading" Size="MarkerSize" Class="md-label" />
                }
            }
        </g>;
    <DrawingCanvas @ref="_canvas" FitText="@FitText" Viewport="_view" ViewportChanged="OnViewChanged" AutoFit="_bounds" ShowGrid="ShowGrid" ShowScaleBar="ShowScaleBar"
                   PanWithPrimaryButton="!IsEditable" Label="@(Label ?? _module?.Title)" Class="module-view"
                   OnPointerDown="OnPointerDown" OnPointerMove="OnPointerMove" OnPointerUp="OnPointerUp" OnKeyDownCallback="OnKeyDown" Overlay="Overlay">
        @content
    </DrawingCanvas>
    @if (PrintTitle is not null)
    {
        @* The drawing as printed, fitted to the page whatever the zoom; the host's print styles show .print-sheet instead of the screen. *@
        var title = PrintTitlePosition;
        var box = PrintBounds;
        <div class="print-sheet" aria-hidden="true">
            <svg class="print-drawing" viewBox="@(new ViewBox(box.Min.X, -box.Max.Y, box.Width, box.Height))" preserveAspectRatio="xMidYMid meet">
                <g transform="scale(1,-1)">
                    @content
                    <WorldText At="title" Text="@PrintTitle" Size="PrintTitleSize" FontWeight="bold" Class="md-label md-print-title" />
                </g>
            </svg>
        </div>
    }
}

@code {
    private const double MarkerSizePerExtent = 0.03;
    private const double MinimumMarkerSize = 20;
    private const double MarginPerExtent = 0.06;
    private const double ProfileNameRelativeSize = 1.4;
    private const double PrintTitleRelativeSize = 2;

    private Module? _module;
    private ModuleDrawing? _drawing;
    private IReadOnlyList<EndPlate> _plates = [];
    private IReadOnlyList<StationTrackLabel> _trackLabels = [];
    private IReadOnlyList<ProfileShade> _shades = [];
    private IReadOnlyDictionary<string, (string Text, double Depth)> _profileNames = new Dictionary<string, (string, double)>();
    private BoundingBox _bounds;
    private ModuleNameText? _name;
    private ModuleNamePlacement? _namePlacement;
    private Viewport _view = default!;
    private object? _source;

    /// <summary>The module to show; or give <see cref="Json"/>.</summary>
    [Parameter] public Module? Module { get; set; }

    /// <summary>A module file (<c>.tdmodule</c>), as an alternative to <see cref="Module"/>; it brings its end profiles.</summary>
    [Parameter] public string? Json { get; set; }

    /// <summary>The drawing as edited, shown instead of the module's own; the view keeps its zoom when it changes.</summary>
    [Parameter] public ModuleDrawing? Drawing { get; set; }

    /// <summary>True in an editor: the primary button goes to the pointer callbacks, and panning uses the middle button or Space.</summary>
    [Parameter] public bool IsEditable { get; set; }

    /// <summary>Content drawn above the module, e.g. an editor's handles and previews.</summary>
    [Parameter] public RenderFragment? Overlay { get; set; }

    [Parameter] public EventCallback<CanvasPointerEventArgs> OnPointerDown { get; set; }
    [Parameter] public EventCallback<CanvasPointerEventArgs> OnPointerMove { get; set; }
    [Parameter] public EventCallback<CanvasPointerEventArgs> OnPointerUp { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    /// <summary>Raised when the view is panned, zoomed or resized, e.g. so an editor can size its handles.</summary>
    [Parameter] public EventCallback<Viewport> ViewChanged { get; set; }

    /// <summary>The view now shown.</summary>
    public Viewport View => _view;

    /// <summary>
    /// Looks up end profiles for the end plates, shading and names; not needed with <see cref="Json"/>.
    /// With <see cref="Json"/>, profiles it doesn't find are taken from the file.
    /// </summary>
    [Parameter] public Func<Guid, EndProfile?>? EndProfiles { get; set; }

    /// <summary>The module's standard, for the track colour.</summary>
    [Parameter] public ModuleStandard? Standard { get; set; }

    [Parameter] public ModuleLayers Layers { get; set; } = ModuleLayers.All;

    /// <summary>
    /// The station tracks whose designations are written, e.g. an editor's current list; null for those of the module.
    /// </summary>
    [Parameter] public IReadOnlyList<Tellurian.Trains.Schedules.Model.Layouts.StationTrack>? Tracks { get; set; }

    /// <summary>
    /// When given, a print sheet is rendered too: the drawing with this title below it, in a <c>div.print-sheet</c>
    /// that the host's print styles show instead of the screen (as for end profiles).
    /// </summary>
    [Parameter] public string? PrintTitle { get; set; }
    [Parameter] public bool ShowGrid { get; set; }
    [Parameter] public bool ShowScaleBar { get; set; } = true;
    [Parameter] public string Error { get; set; } = "The module can't be shown.";
    [Parameter] public string? Label { get; set; }

    /// <summary>The tooltip of the fit-in-view button; the host passes its translation.</summary>
    [Parameter] public string FitText { get; set; } = "Fit in view";
    [Parameter] public double Width { get; set; } = 800;
    [Parameter] public double Height { get; set; } = 400;

    private string TrackColor => Standard?.TrackColor ?? ModuleStandard.DefaultTrackColor;
    private double PrintTitleSize => MarkerSize * PrintTitleRelativeSize;
    private Point PrintTitlePosition => new((_bounds.Min.X + _bounds.Max.X) / 2, _bounds.Min.Y - PrintTitleSize);
    private BoundingBox PrintBounds => _bounds.Including(PrintTitlePosition - new Vector(0, PrintTitleSize));

    private double MarkerSize => Math.Max(Math.Max(_bounds.Width, _bounds.Height) * MarkerSizePerExtent, MinimumMarkerSize);

    private DrawingCanvas? _canvas;

    /// <summary>Fits the view to the whole module, e.g. after an editor has drawn it again in another shape.</summary>
    public Task FitAsync() => _canvas?.ZoomToAsync(_bounds) ?? Task.CompletedTask;

    private async Task OnViewChanged(Viewport view)
    {
        _view = view;
        await ViewChanged.InvokeAsync(view);
    }

    private Func<Guid, EndProfile?>? _lookup;

    protected override void OnParametersSet()
    {
        object? source = Module ?? (object?)Json;
        if (ReferenceEquals(source, _source) && _drawing is not null)
        {
            // An editor's changed drawing is drawn again with the same view.
            if (Drawing is { } edited && !ReferenceEquals(edited, _drawing)) Show(edited, fit: false);
            return;
        }
        _source = source;
        Func<Guid, EndProfile?>? lookup = EndProfiles;
        _module = Module;
        if (_module is null && Json is not null)
        {
            try
            {
                var file = DrawingFileSerializer.DeserializeModule(Json);
                _module = file.Module;
                var given = lookup;
                lookup = given is null ? file.FindEndProfile : id => given(id) ?? file.FindEndProfile(id);
            }
            catch (DrawingFileException)
            {
                _module = null;
            }
        }
        _lookup = lookup;
        var drawing = Drawing ?? _module?.Drawing;
        if (drawing is null)
        {
            _drawing = null;
            return;
        }
        Show(drawing, fit: true);
    }

    /// <summary>Works out what is drawn for <paramref name="drawing"/>; <paramref name="fit"/> fits the view to it.</summary>
    private void Show(ModuleDrawing drawing, bool fit)
    {
        _drawing = drawing;
        _plates = Plates(drawing, _lookup);
        _shades = Shades(drawing, _lookup);
        _profileNames = ProfileNames(drawing, _lookup);
        _bounds = Bounds(drawing, _plates);
        if (fit) _view = Viewport.Fit(_bounds, Width, Height);
        _name = ModuleNameLabel.Text(_module!);
        _trackLabels = StationTrackLabels.Of(Tracks ?? (IEnumerable<Tellurian.Trains.Schedules.Model.Layouts.StationTrack>?)_module?.Tracks ?? [], drawing);
        _namePlacement = _name is null ? null : NamePlacement(drawing, _name, _lookup);
    }

    private bool Show(ModuleLayers layer) => Layers.HasFlag(layer);

    private IEnumerable<SegmentPath> PublicSidePaths()
    {
        foreach (var side in _drawing!.PublicSides)
        {
            if (side.Attachment.SideIndex < 0 || side.Attachment.SideIndex >= _drawing.Sides.Count) continue;
            var path = _drawing.Sides[side.Attachment.SideIndex].Path.ToPath();
            var to = Math.Min(side.Attachment.To ?? path.Length, path.Length);
            if (to - side.Attachment.From > Tolerance.Length) yield return path.Between(side.Attachment.From, to);
        }
    }

    /// <summary>The name along the track, as the module is shown here: not turned (a hall plan passes its placement's rotation).</summary>
    private ModuleNamePlacement NamePlacement(ModuleDrawing drawing, ModuleNameText name, Func<Guid, EndProfile?>? lookup)
    {
        var gauge = drawing.Exits.Select(e => lookup?.Invoke(e.EndProfile.Id)?.Tracks.FirstOrDefault()?.WidestGauge).FirstOrDefault(g => g is not null) ?? Standard?.NormalGauge;
        var trackHalfWidth = gauge is { } g ? TrackCrossSection.SleeperLength(g) / 2 : MarkerSize / 2;
        return ModuleNameLabel.Place(drawing, name, Angle.Zero, trackHalfWidth);
    }

    private static IReadOnlyList<EndPlate> Plates(ModuleDrawing drawing, Func<Guid, EndProfile?>? lookup) =>
        lookup is null
            ? []
            : [.. drawing.Exits.Select(e => lookup(e.EndProfile.Id) is { } profile ? ModuleGeometry.EndPlate(e, profile) : null).OfType<EndPlate>()];

    private static IReadOnlyList<ProfileShade> Shades(ModuleDrawing drawing, Func<Guid, EndProfile?>? lookup) =>
        lookup is null
            ? []
            : [.. drawing.Exits.SelectMany(e => lookup(e.EndProfile.Id) is { } profile ? ProfileShading.Shades(e, profile) : [])];

    /// <summary>
    /// The end profile's short name per exit label, or its designation (ModuleDrawing §9), with how far its
    /// shading reaches into the module, so the name goes just beyond it.
    /// </summary>
    private static Dictionary<string, (string Text, double Depth)> ProfileNames(ModuleDrawing drawing, Func<Guid, EndProfile?>? lookup) =>
        drawing.Exits.DistinctBy(e => e.Label).ToDictionary(
            e => e.Label,
            e => lookup?.Invoke(e.EndProfile.Id) is { } profile
                ? (profile.ShortNameOrDesignation, ProfileShading.Depth(profile))
                : (e.EndProfile.Name, 0.0));

    private static BoundingBox Bounds(ModuleDrawing drawing, IReadOnlyList<EndPlate> plates)
    {
        var box = BoundingBox.Empty;
        foreach (var path in drawing.Sections.Select(s => s.Outline).Concat(drawing.Sides.Select(s => s.Path)).Concat(drawing.OperatorSpaces.Select(o => o.Area)))
            box = box.Union(path.ToPath().Bounds);
        foreach (var track in drawing.TrackElements) box = track.Routes().Aggregate(box, (b, r) => b.Union(r.Bounds));
        foreach (var exit in drawing.Exits) box = box.Including(exit.Pose.Position);
        foreach (var plate in plates) box = box.Including(plate.LeftCorner).Including(plate.RightCorner);
        if (box.IsEmpty) box = new(Point.Origin, Point.Origin);
        return box.Inflated(Math.Max(Math.Max(box.Width, box.Height) * MarginPerExtent, MinimumMarkerSize * 3));
    }
}
