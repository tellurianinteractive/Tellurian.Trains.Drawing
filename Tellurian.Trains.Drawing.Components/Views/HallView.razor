@using Tellurian.Trains.Drawing.Components.Rendering
@using Tellurian.Trains.Drawing.Editing.Viewing
@using Tellurian.Trains.Drawing.Geometry
@using Tellurian.Trains.Drawing.Model.Files
@using Tellurian.Trains.Drawing.Model.Halls

@* Read-only plan of a hall (EX-8): walls, obstacles, doors with keep-free zones, no-go zones. Works without JS. *@
@if (_hall is null)
{
    <p class="drawing-view-error">@Error</p>
}
else
{
    <DrawingCanvas Viewport="_view" ViewportChanged="v => _view = v" AutoFit="_bounds" ShowGrid="ShowGrid" ShowScaleBar="ShowScaleBar"
                   PanWithPrimaryButton="true" Label="@(Label ?? _hall.Name)" Class="hall-view">
        @if (Show(HallLayers.Walls))
        {
            <path class="hl-floor" d="@SvgPath.From(_hall.Outline)" />
        }
        @if (Show(HallLayers.NoGoZones))
        {
            @foreach (var zone in _hall.NoGoZones)
            {
                <path class="hl-no-go" d="@SvgPath.From(zone.Area)" />
                @if (Show(HallLayers.Labels))
                {
                    <WorldText At="zone.Area.ToPath().Bounds.Center" Text="@zone.Reason" Size="TextSize" Class="hl-label" />
                }
            }
        }
        @if (Show(HallLayers.Doors))
        {
            @foreach (var door in _hall.Doors)
            {
                <path class="@(door.Kind == DoorKind.EmergencyExit ? "hl-keep-free emergency" : "hl-keep-free")" d="@SvgPath.From(door.KeepFreeZone())" />
                var half = door.Position.Left * (door.Width / 2);
                <line class="hl-door" x1="@SvgPath.Number((door.Position.Position + half).X)" y1="@SvgPath.Number((door.Position.Position + half).Y)"
                      x2="@SvgPath.Number((door.Position.Position - half).X)" y2="@SvgPath.Number((door.Position.Position - half).Y)" />
                @if (Show(HallLayers.Labels) && door.Label is { } label)
                {
                    <WorldText At="door.Position.Advanced(door.KeepFreeDepth / 2).Position" Text="@label" Size="TextSize" Class="hl-label" />
                }
            }
        }
        @if (Show(HallLayers.Obstacles))
        {
            @foreach (var obstacle in _hall.Obstacles)
            {
                <path class="@(obstacle.Kind == ObstacleKind.Pillar ? "hl-obstacle pillar" : "hl-obstacle")" d="@SvgPath.From(obstacle.Area)" />
                @if (Show(HallLayers.Labels) && obstacle.Label is { } label)
                {
                    <WorldText At="obstacle.Area.ToPath().Bounds.Center" Text="@label" Size="TextSize" Class="hl-label" />
                }
            }
        }
        @if (Show(HallLayers.Walls))
        {
            <path class="hl-walls" d="@SvgPath.From(_hall.Outline)" />
        }
    </DrawingCanvas>
}

@code {
    private const double TextSizePerExtent = 0.02;
    private const double MarginPerExtent = 0.04;

    private Hall? _hall;
    private BoundingBox _bounds;
    private Viewport _view = default!;
    private object? _source;

    /// <summary>The hall to show; or give <see cref="Json"/>.</summary>
    [Parameter] public Hall? Hall { get; set; }

    /// <summary>A hall file (<c>.tdhall</c>), as an alternative to <see cref="Hall"/>.</summary>
    [Parameter] public string? Json { get; set; }

    [Parameter] public HallLayers Layers { get; set; } = HallLayers.All;
    [Parameter] public bool ShowGrid { get; set; } = true;
    [Parameter] public bool ShowScaleBar { get; set; } = true;
    [Parameter] public string Error { get; set; } = "The hall can't be shown.";
    [Parameter] public string? Label { get; set; }
    [Parameter] public double Width { get; set; } = 800;
    [Parameter] public double Height { get; set; } = 500;

    private double TextSize => Math.Max(_bounds.Width, _bounds.Height) * TextSizePerExtent;

    protected override void OnParametersSet()
    {
        object? source = Hall ?? (object?)Json;
        if (ReferenceEquals(source, _source) && _hall is not null) return;
        _source = source;
        _hall = Hall;
        if (_hall is null && Json is not null)
        {
            try
            {
                _hall = DrawingFileSerializer.DeserializeHall(Json);
            }
            catch (DrawingFileException)
            {
                _hall = null;
            }
        }
        if (_hall is null) return;
        var box = _hall.Outline.ToPath().Bounds;
        _bounds = box.Inflated(Math.Max(box.Width, box.Height) * MarginPerExtent);
        _view = Viewport.Fit(_bounds, Width, Height);
    }

    private bool Show(HallLayers layer) => Layers.HasFlag(layer);
}
